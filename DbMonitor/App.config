<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!--
      Verbindungszeichenfolge zur Oracle-Datenbank.
      Vor der Verwendung bitte anpassen:
        DATA SOURCE = TNS-Alias oder Host:Port/ServiceName
        User Id     = Datenbankbenutzer
        Password    = Passwort (nur wenn keine Wallet-Authentifizierung)
      
      Beispiel mit lokaler Oracle XE:
        DATA SOURCE=localhost:1521/XEPDB1;User Id=system;Password=IhrPasswort;
      
      Beispiel mit Oracle Wallet (OS-Authentifizierung):
        DATA SOURCE=MEIN_TNS_ALIAS;User Id=/;
    -->
    <add name="defaultConnectionString"
         connectionString="DATA SOURCE=localhost:1521/XEPDB1;User Id=C##MONITOR_USER;Password=IhrPasswort;"
         providerName="Oracle.ManagedDataAccess.Client" />
  </connectionStrings>
</configuration>