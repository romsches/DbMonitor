<UserControl x:Class="DbMonitorWPF.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:DbMonitorWPF.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="450" 
             d:DesignWidth="800">

  <Grid Margin="5">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="150"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0">
      <StackPanel DockPanel.Dock="Top" 
                        Orientation="Horizontal" 
                        Margin="0,0,0,5">
        <Button Content="Jobs aktualisieren" 
                        Command="{Binding JobsAktualisierenBefehl}" 
                        Style="{StaticResource AnalysisButtonStyle}"/>

        <TextBlock Text="Filter:" 
                           VerticalAlignment="Center" 
                           Margin="10,0,5,0"/>

        <TextBox Width="150" 
                         Text="{Binding FilterTextJobs, UpdateSourceTrigger=PropertyChanged}" 
                         VerticalAlignment="Center"/>

        <TextBlock Text="{Binding StatusJobs, Mode=OneWay}" 
                           Style="{StaticResource StatusTextStyle}" 
                           Margin="10,0,0,0"/>
      </StackPanel>

      <DataGrid ItemsSource="{Binding JobsAnsicht}" 
                      SelectedItem="{Binding AusgewaehlterJob}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      BorderThickness="0" 
                      HeadersVisibility="Column"
                      SelectionUnit="FullRow"
                      SelectionMode="Single"
                      ClipboardCopyMode="IncludeHeader"
                      PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">

        <DataGrid.CommandBindings>
          <CommandBinding Command="{x:Static helpers:DataGridHelper.CopyRowCommand}" 
                                    Executed="CopyRow_Executed" />
        </DataGrid.CommandBindings>

        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Zelle kopieren" Click="CopyCell_Click" />
            <MenuItem Header="Zeile kopieren" Command="{x:Static helpers:DataGridHelper.CopyRowCommand}" />
          </ContextMenu>
        </DataGrid.ContextMenu>

        <DataGrid.Columns>
          <DataGridTextColumn Header="Job-Name" Binding="{Binding JOB_NAME}" Width="200"/>
          <DataGridTextColumn Header="Aktion" Binding="{Binding JOB_ACTION}" Width="*"/>
          <DataGridTextColumn Header="Status" Binding="{Binding STATUS}" Width="100"/>
          <DataGridTextColumn Header="Start-Datum" 
                                        Binding="{Binding START_DATE, StringFormat='{}{0:dd.MM.yy HH:mm}'}" 
                                        Width="120"/>
          <DataGridTextColumn Header="Läufe" 
                                        Binding="{Binding RUN_COUNT}" 
                                        Width="60" 
                                        ElementStyle="{StaticResource ZahlSpalteStyle}"/>
          <DataGridTextColumn Header="Fehler" 
                                        Binding="{Binding FAILURE_COUNT}" 
                                        Width="60" 
                                        ElementStyle="{StaticResource ZahlSpalteStyle}"/>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

    <GridSplitter Grid.Row="1" 
                      Height="5" 
                      HorizontalAlignment="Stretch" 
                      Background="#DDD"/>

    <GroupBox Grid.Row="2" 
                  Header="{Binding StatusJobProtokolle}" 
                  Margin="0,5,0,0">
      <DataGrid ItemsSource="{Binding AusgewaehlteJobProtokolle}" 
                      AutoGenerateColumns="True" 
                      IsReadOnly="True" 
                      BorderThickness="0" 
                      HeadersVisibility="Column"
                      SelectionUnit="FullRow"
                      SelectionMode="Single"
                      ClipboardCopyMode="IncludeHeader"
                      PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">

        <DataGrid.CommandBindings>
          <CommandBinding Command="{x:Static helpers:DataGridHelper.CopyRowCommand}" 
                                    Executed="CopyRow_Executed" />
        </DataGrid.CommandBindings>

        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Zelle kopieren" Click="CopyCell_Click" />
            <MenuItem Header="Zeile kopieren" Command="{x:Static helpers:DataGridHelper.CopyRowCommand}" />
          </ContextMenu>
        </DataGrid.ContextMenu>
      </DataGrid>
    </GroupBox>
  </Grid>
</UserControl>
