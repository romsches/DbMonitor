<UserControl x:Class="DbMonitorWPF.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:DbMonitorWPF.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="450" 
             d:DesignWidth="800">

  <DockPanel Margin="5">
    <StackPanel DockPanel.Dock="Top" 
                    Orientation="Horizontal" 
                    Margin="0,0,0,5">

      <Button Content="Audit-Log aktualisieren" 
                    Command="{Binding RefreshCommand}" 
                    Style="{StaticResource AnalysisButtonStyle}" />

      <TextBlock Text="Filter:" 
                       VerticalAlignment="Center" 
                       Margin="10,0,5,0" />

      <TextBox Width="150" 
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" 
                     VerticalAlignment="Center" />

      <TextBlock Text="{Binding Status, Mode=OneWay}" 
                       Style="{StaticResource StatusTextStyle}" 
                       VerticalAlignment="Center" 
                       Margin="10,0,0,0" />
    </StackPanel>

    <DataGrid ItemsSource="{Binding AuditLogAnsicht}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  AlternatingRowBackground="#FAFAFA"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="0"
                  HeadersVisibility="Column"
                  SelectionUnit="FullRow"
                  SelectionMode="Single"
                  ClipboardCopyMode="IncludeHeader"
                  PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">

      <DataGrid.CommandBindings>
        <CommandBinding Command="{x:Static helpers:DataGridHelper.CopyRowCommand}" 
                                Executed="CopyRow_Executed" />
      </DataGrid.CommandBindings>

      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Zelle kopieren" 
                              Click="CopyCell_Click" />
          <MenuItem Header="Zeile kopieren" 
                              Command="{x:Static helpers:DataGridHelper.CopyRowCommand}" />
        </ContextMenu>
      </DataGrid.ContextMenu>

      <DataGrid.Columns>
        <DataGridTextColumn Header="Zeitpunkt" 
                                    Binding="{Binding KILL_DATE, StringFormat='{}{0:dd.MM.yy HH:mm:ss}'}" 
                                    Width="120" />
        <DataGridTextColumn Header="User" 
                                    Binding="{Binding DAL_USERNAME}" 
                                    Width="80" />
        <DataGridTextColumn Header="SID" 
                                    Binding="{Binding DAL_SID}" 
                                    Width="50" 
                                    ElementStyle="{StaticResource ZahlSpalteStyle}" />
        <DataGridTextColumn Header="Serial" 
                                    Binding="{Binding DAL_SERIAL}" 
                                    Width="60" 
                                    ElementStyle="{StaticResource ZahlSpalteStyle}" />
        <DataGridTextColumn Header="OS User" 
                                    Binding="{Binding DAL_OSUSER}" 
                                    Width="100" />
        <DataGridTextColumn Header="Program" 
                                    Binding="{Binding DAL_PROGRAM}" 
                                    Width="150" />
        <DataGridTextColumn Header="Terminal" 
                                    Binding="{Binding DAL_TERMINAL}" 
                                    Width="100" />
        <DataGridTextColumn Header="Kommentar" 
                                    Binding="{Binding DAL_REASON}" 
                                    Width="200" />
        <DataGridTextColumn Header="SQL Text" 
                                    Binding="{Binding DAL_SQL_TEXT}" 
                                    Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
