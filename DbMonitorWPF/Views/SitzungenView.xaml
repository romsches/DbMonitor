<UserControl x:Class="DbMonitorWPF.Views.SitzungenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
             xmlns:helpers="clr-namespace:DbMonitorWPF.Helpers">

  <Grid Margin="5">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="170"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
        <Button Content="Sitzungen aktualisieren"
                Command="{Binding SitzungenAktualisierenBefehl}"
                Style="{StaticResource AnalysisButtonStyle}"/>

        <Label Content="Filter:" VerticalAlignment="Center" Margin="10,0,0,0"/>
        <TextBox Text="{Binding FilterTextSitzungen, UpdateSourceTrigger=PropertyChanged}"
                 Width="180" 
                 VerticalAlignment="Center" 
                 Margin="5,0,0,0"
                 ToolTip="Sucht in: User, OS-User, Maschine, Terminal, Programm, Status, SID, Prozess-ID, Serial, Anmeldung"/>

        <TextBlock Text="{Binding StatusSitzungen, Mode=OneWay}"
                   Style="{StaticResource StatusTextStyle}"/>
      </StackPanel>

      <DataGrid ItemsSource="{Binding Sitzungen}"
                SelectedItem="{Binding AusgewaehlteSitzung}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                BorderThickness="0"
                SelectionUnit="FullRow"
                SelectionMode="Single"
                ClipboardCopyMode="IncludeHeader"
                GridLinesVisibility="Horizontal"
                AlternatingRowBackground="#FAFAFA"
                HeadersVisibility="Column"
                PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">

        <DataGrid.CommandBindings>
          <CommandBinding Command="{x:Static helpers:DataGridHelper.CopyRowCommand}" 
                          Executed="CopyRow_Executed" />
        </DataGrid.CommandBindings>

        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Zelle kopieren" Click="CopyCell_Click" />
            <MenuItem Header="Zeile kopieren" Command="{x:Static helpers:DataGridHelper.CopyRowCommand}" />
          </ContextMenu>
        </DataGrid.ContextMenu>

        <DataGrid.Columns>
          <DataGridTextColumn Header="SID" Width="60" Binding="{Binding SID, StringFormat='{}{0:N0}'}"/>
          <DataGridTextColumn Header="Serial" Width="65" Binding="{Binding SERIAL, StringFormat='{}{0:N0}'}"/>
          <DataGridTextColumn Header="Benutzer" Width="110" Binding="{Binding USERNAME}"/>
          <DataGridTextColumn Header="OS-User"   Binding="{Binding OSUSER}"    Width="110"/>
          <DataGridTextColumn Header="Maschine"  Binding="{Binding MACHINE}"   Width="130"/>
          <DataGridTextColumn Header="Programm"  Binding="{Binding PROGRAM}"   Width="*"/>
          <DataGridTextColumn Header="Status"    Binding="{Binding STATUS}"    Width="80"/>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

    <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#DDD"/>

    <GroupBox Grid.Row="2" Header="SQL-Text und Bind-Variablen der ausgewählten Sitzung" Margin="0,5,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <avalonEdit:TextEditor Grid.Column="0"
                               Name="SqlEditorSitzungen"
                               SyntaxHighlighting="SQL"
                               ShowLineNumbers="True"
                               IsReadOnly="True"
                               FontFamily="Consolas" FontSize="14" />

        <Grid Grid.Column="1" Margin="5,0,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <CheckBox Grid.Row="0" 
                    Content="Unformatiert"
                    IsChecked="{Binding IstSqlFormatiert, UpdateSourceTrigger=PropertyChanged}" 
                    Margin="0,0,0,5" />

          <Button Grid.Row="1" Content="Kopieren" 
                  Command="{Binding KopiereSitzungsSqlBefehl}" 
                  Margin="0,0,0,5"
                  Width="80"/>

          <Button Grid.Row="2"
                  Content="Session&#10;beenden"
                  Command="{Binding SitzungBeendenBefehl}"
                  Style="{StaticResource KillButtonStyle}"
                  Width="80"
                  VerticalAlignment="Stretch"/>
        </Grid>
      </Grid>
    </GroupBox>
  </Grid>
</UserControl>
