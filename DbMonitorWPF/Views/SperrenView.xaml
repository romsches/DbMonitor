<UserControl x:Class="DbMonitorWPF.Views.SperrenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:helpers="clr-namespace:DbMonitorWPF.Helpers"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">

  <Grid Margin="5">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="130"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
        <Button Content="Sperren aktualisieren" Command="{Binding SperrenAktualisierenBefehl}" Style="{StaticResource AnalysisButtonStyle}"/>
        <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="10,0,5,0"/>
        <TextBox Width="150" Text="{Binding FilterTextSperren, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding StatusSperren, Mode=OneWay}" Style="{StaticResource StatusTextStyle}" Margin="10,0,0,0"/>
      </StackPanel>

      <DataGrid ItemsSource="{Binding SperrenAnsicht}" SelectedItem="{Binding AusgewaehlteSperre}" 
                AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" HeadersVisibility="Column"
                SelectionUnit="FullRow" SelectionMode="Single" ClipboardCopyMode="IncludeHeader" 
                GridLinesVisibility="Horizontal" AlternatingRowBackground="#FAFAFA" 
                PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
        <DataGrid.CommandBindings>
          <CommandBinding Command="{x:Static helpers:DataGridHelper.CopyRowCommand}" Executed="CopyRow_Executed" />
        </DataGrid.CommandBindings>
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Zelle kopieren" Click="CopyCell_Click" />
            <MenuItem Header="Zeile kopieren" Command="{x:Static helpers:DataGridHelper.CopyRowCommand}" />
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTextColumn Header="SID" Width="60" Binding="{Binding SID, StringFormat='{}{0:N0}'}"/>
          <DataGridTextColumn Header="Serial" Width="65" Binding="{Binding SERIAL, StringFormat='{}{0:N0}'}"/>
          <DataGridTextColumn Header="Benutzer" Binding="{Binding USERNAME}" Width="110"/>
          <DataGridTextColumn Header="OS-User" Binding="{Binding OSUSER}" Width="110"/>
          <DataGridTextColumn Header="Maschine" Binding="{Binding MACHINE}" Width="130"/>
          <DataGridTextColumn Header="Programm" Binding="{Binding PROGRAM}" Width="*"/>
          <DataGridTextColumn Header="Lock-Typ" Binding="{Binding TYPE}" Width="80"/>
          <DataGridTextColumn Header="Modus" Binding="{Binding STATUS_AKTUELL}" Width="120"/>
          <DataGridTextColumn Header="Angefragt" Binding="{Binding ANGEFRAGT}" Width="100"/>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

    <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#DDD"/>

    <GroupBox Grid.Row="2" Header="SQL-Text der blockierenden Session" Margin="0,5,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <avalonEdit:TextEditor Grid.Column="0" 
                           Name="SqlEditorSperren" 
                           SyntaxHighlighting="SQL" 
                           ShowLineNumbers="True" 
                           IsReadOnly="True" 
                           FontFamily="Consolas" 
                           FontSize="11" />

        <Grid Grid.Column="1" Margin="5,0,0,0" Width="80">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <CheckBox Grid.Row="0" 
                Content="Unformatiert"
                IsChecked="{Binding IstSqlFormatiert, UpdateSourceTrigger=PropertyChanged}" 
                Margin="0,0,0,5" />

          <Button Grid.Row="1" Content="Kopieren" 
              Command="{Binding KopiereSperrenSqlBefehl}" 
              Margin="0,0,0,5"/>

          <Button Grid.Row="2"
              Content="Sperrung&#10;beenden"
              Command="{Binding SperreBeendenBefehl}"
              Style="{StaticResource KillButtonStyle}"
              VerticalAlignment="Stretch"/>
        </Grid>
      </Grid>
    </GroupBox>
  </Grid>
</UserControl>
