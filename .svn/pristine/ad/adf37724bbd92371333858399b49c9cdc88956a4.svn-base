using System.ComponentModel;
using System.Windows;
using System.Windows.Controls;
using Bsd.DbMonitorWPF.ViewModels;
using ICSharpCode.AvalonEdit.Highlighting;
using ICSharpCode.AvalonEdit;

namespace Bsd.DbMonitorWPF.Views
{
  /// <summary>
  /// Code-Behind für die SitzungenView.
  /// Verantwortlich für die Anzeige der aktiven Benutzersitzungen und die 
  /// Synchronisation des SQL-Editors mit dem ausgewählten Sitzungseintrag.
  /// </summary>
  public partial class SitzungenView : UserControl
  {
    #region Konstruktor

    /// <summary>
    /// Initialisiert eine neue Instanz der <see cref="SitzungenView"/> Klasse.
    /// </summary>
    public SitzungenView()
    {
      InitializeComponent();
      ApplySqlHighlighting(SqlEditorSitzungen);

      this.Loaded += OnViewLoaded;
      this.DataContextChanged += OnDataContextChanged;
    }

    #endregion

    #region Event-Handler

    /// <summary>
    /// Löst beim Laden der View den initialen Aktualisierungsbefehl aus.
    /// </summary>
    private void OnViewLoaded(object sender, RoutedEventArgs e)
    {
      if (DataContext is SitzungenViewModel vm)
      {
        vm.SitzungenAktualisierenBefehl.Execute(null);
      }
    }

    /// <summary>
    /// Verwaltet das Abonnement für Property-Änderungen bei einem Wechsel des DataContext.
    /// </summary>
    private void OnDataContextChanged(object sender, DependencyPropertyChangedEventArgs e)
    {
      if (e.OldValue is SitzungenViewModel oldVm)
      {
        oldVm.PropertyChanged -= Vm_PropertyChanged;
      }

      if (e.NewValue is SitzungenViewModel newVm)
      {
        newVm.PropertyChanged += Vm_PropertyChanged;
        UpdateEditorContent(newVm);
      }
    }

    /// <summary>
    /// Reagiert auf Änderungen relevanter Properties im ViewModel zur Aktualisierung der Anzeige.
    /// </summary>
    private void Vm_PropertyChanged(object sender, PropertyChangedEventArgs e)
    {
      if (sender is SitzungenViewModel vm && e.PropertyName == nameof(SitzungenViewModel.AktuellerSitzungSqlText))
      {
        UpdateEditorContent(vm);
      }
    }

    #endregion

    #region Private Methoden

    /// <summary>
    /// Aktualisiert den SQL-Text im Editor basierend auf dem ViewModel-Status.
    /// </summary>
    /// <param name="vm">Das aktuelle SitzungenViewModel.</param>
    private void UpdateEditorContent(SitzungenViewModel vm)
    {
      SqlEditorSitzungen.Text = vm.AktuellerSitzungSqlText ?? string.Empty;

      // Syntax-Highlighting bei Bedarf neu setzen
      if (SqlEditorSitzungen.SyntaxHighlighting == null)
      {
        ApplySqlHighlighting(SqlEditorSitzungen);
      }
    }

    /// <summary>
    /// Wendet das SQL-Syntax-Highlighting auf den angegebenen Editor an.
    /// </summary>
    /// <param name="editor">Die AvalonEdit TextEditor-Instanz.</param>
    private void ApplySqlHighlighting(TextEditor editor)
    {
      editor.SyntaxHighlighting = HighlightingManager.Instance.GetDefinition("SQL")
                               ?? HighlightingManager.Instance.GetDefinition("TSQL");
    }

    #endregion
  }
}
