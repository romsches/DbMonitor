<UserControl x:Class="Bsd.DbMonitorWPF.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">

  <!-- ═══════════════════════════════════════════════════════════════════
       Ressourcen: Stile für Schaltflächen und Dashboard-Karten
       ═══════════════════════════════════════════════════════════════════ -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/BSD_WPFObjects;component/SharedDictionary.xaml"/>
        <ResourceDictionary Source="../LocalDictionary.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

      <Style x:Key="AnalysisButtonStyle" TargetType="Button">
        <Setter Property="Padding"          Value="15,8"/>
        <Setter Property="Margin"           Value="5"/>
        <Setter Property="Background"       Value="#E3F2FD"/>
        <Setter Property="BorderBrush"      Value="#2196F3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="#BBDEFB"/>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Opacity" Value="0.5"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="KillButtonStyle" TargetType="Button">
        <Setter Property="Padding"          Value="10,5"/>
        <Setter Property="Margin"           Value="5"/>
        <Setter Property="Background"       Value="#FF5252"/>
        <Setter Property="Foreground"       Value="White"/>
        <Setter Property="BorderBrush"      Value="#D32F2F"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="#D32F2F"/>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Background" Value="#BDBDBD"/>
            <Setter Property="Foreground"  Value="#757575"/>
            <Setter Property="Cursor"      Value="Arrow"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="InfoCardStyle" TargetType="Border">
        <Setter Property="CornerRadius"    Value="8"/>
        <Setter Property="BorderBrush"      Value="#DDD"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"          Value="10"/>
      </Style>

      <Style x:Key="ZahlSpalteStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin"              Value="0,0,5,0"/>
      </Style>

      <Style x:Key="StatusTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin"            Value="10,0,0,0"/>
        <Setter Property="Foreground"        Value="Gray"/>
        <Setter Property="FontStyle"         Value="Italic"/>
        <Setter Property="FontSize"          Value="11"/>
      </Style>

    </ResourceDictionary>
  </UserControl.Resources>

  <!-- Lifecycle-Commands über Behavior – kein Code-Behind erforderlich -->
  <i:Interaction.Triggers>
    <i:EventTrigger EventName="Loaded">
      <i:InvokeCommandAction Command="{Binding LoadedBefehl}"/>
    </i:EventTrigger>
    <i:EventTrigger EventName="Unloaded">
      <i:InvokeCommandAction Command="{Binding UnloadedBefehl}"/>
    </i:EventTrigger>
  </i:Interaction.Triggers>

  <Grid Background="#F5F5F5" Margin="5">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ═══════════════════════════════════════════════════════════════════
         Haupt-TabControl mit SelectedIndex-Binding für Dashboard-Navigation
         ═══════════════════════════════════════════════════════════════════ -->
    <TabControl Grid.Row="0"
                SelectedIndex="{Binding AktiverTabIndex}"
                TabStripPlacement="Top">

      <!-- ═══════════════════════════════════════════════
           Tab 0: Dashboard
           ═══════════════════════════════════════════════ -->
      <TabItem Header="Dashboard">
        <Grid Margin="15">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <UniformGrid Grid.Row="0" Rows="1" Height="90" Margin="0,0,0,15">

            <Button Command="{Binding WechsleZuSitzungenBefehl}" Cursor="Hand" Margin="0,0,8,0">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <ContentPresenter/>
                </ControlTemplate>
              </Button.Template>
              <Border Style="{StaticResource InfoCardStyle}" Background="#E8F5E9">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Aktive Sitzungen" HorizontalAlignment="Center" Foreground="#2E7D32" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding AnzahlAktiveSitzungen, Mode=OneWay}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2E7D32"/>
                </StackPanel>
              </Border>
            </Button>

            <Button Command="{Binding WechsleZuJobsBefehl}" Cursor="Hand" Margin="4,0">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <ContentPresenter/>
                </ControlTemplate>
              </Button.Template>
              <Border Style="{StaticResource InfoCardStyle}" Background="#FFF3E0">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Auffällige Jobs" HorizontalAlignment="Center" Foreground="#E65100" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding AnzahlAuffaelligeJobs, Mode=OneWay}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#E65100"/>
                </StackPanel>
              </Border>
            </Button>

            <Button Command="{Binding WechsleZuSperrenBefehl}" Cursor="Hand" Margin="8,0,0,0">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <ContentPresenter/>
                </ControlTemplate>
              </Button.Template>
              <Border Style="{StaticResource InfoCardStyle}" Background="#FFEBEE">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Aktive Sperren" HorizontalAlignment="Center" Foreground="#C62828" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding AnzahlSperren, Mode=OneWay}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#C62828"/>
                </StackPanel>
              </Border>
            </Button>
          </UniformGrid>

          <GroupBox Grid.Row="1" Header="Schnell-Analyse" Margin="0,0,0,10" HorizontalAlignment="Stretch">
            <UniformGrid Rows="1" Margin="5">
              <Button Content="Top 20 SQL (nach Ausführungen)"
                Command="{Binding LadeTopSqlBefehl}"
                Style="{StaticResource AnalysisButtonStyle}"
                Margin="0,0,5,0"/>

              <Button Content="Top 20 Prozesse (nach Speicher)"
                Command="{Binding LadeTopProzesseBefehl}"
                Style="{StaticResource AnalysisButtonStyle}"
                Margin="5,0,0,0"/>
            </UniformGrid>
          </GroupBox>

        </Grid>
      </TabItem>

      <!-- ═══════════════════════════════════════════════
           Tab 1: Sitzungen (V$SESSION)
           ═══════════════════════════════════════════════ -->
      <TabItem Header="Sitzungen (V$SESSION)">
        <Grid Margin="5">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="170"/>
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
              <Button Content="Sitzungen aktualisieren"
                Command="{Binding SitzungenAktualisierenBefehl}"
                Style="{StaticResource AnalysisButtonStyle}"/>
              <Label Content="Filter:" VerticalAlignment="Center" Margin="10,0,0,0"/>
              <TextBox Text="{Binding FilterTextSitzungen, UpdateSourceTrigger=PropertyChanged}"
                 Width="180" VerticalAlignment="Center" Margin="5,0,0,0"
                 ToolTip="Sucht in: User, OS-User, Maschine, Terminal, Programm, Status, SID, Prozess-ID, Serial, Anmeldung"/>
              <TextBlock Text="{Binding StatusSitzungen, Mode=OneWay}"
                   Style="{StaticResource StatusTextStyle}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Sitzungen}"
                SelectedItem="{Binding AusgewaehlteSitzung}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                BorderThickness="0"
                SelectionUnit="FullRow"
                ClipboardCopyMode="IncludeHeader"
                GridLinesVisibility="Horizontal"
                AlternatingRowBackground="#FAFAFA"
                HeadersVisibility="Column">
              <DataGrid.Columns>
                <DataGridTextColumn Header="SID" Width="60" Binding="{Binding SID, StringFormat='{}{0:N0}'}">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource ZahlSpalteStyle}"/>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Serial" Width="65" Binding="{Binding SERIAL, StringFormat='{}{0:N0}'}">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource ZahlSpalteStyle}"/>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Benutzer" Width="110" Binding="{Binding USERNAME}">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="FontWeight" Value="Normal"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding USERNAME}" Value="SYSDRK">
                          <Setter Property="Foreground" Value="DarkRed"/>
                          <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding USERNAME}" Value="SYSADM">
                          <Setter Property="Foreground" Value="DarkBlue"/>
                          <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding USERNAME}" Value="SYSMON">
                          <Setter Property="Foreground" Value="DarkGreen"/>
                          <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="OS-User"   Binding="{Binding OSUSER}"    Width="110"/>
                <DataGridTextColumn Header="Maschine"  Binding="{Binding MACHINE}"   Width="130"/>
                <DataGridTextColumn Header="Terminal"  Binding="{Binding TERMINAL}"  Width="90"/>
                <DataGridTextColumn Header="Programm"  Binding="{Binding PROGRAM}"   Width="*"/>
                <DataGridTextColumn Header="Status"    Binding="{Binding STATUS}"    Width="80"/>
                <DataGridTextColumn Header="Typ"       Binding="{Binding TYPE}"      Width="70"/>
                <DataGridTextColumn Header="Anmeldung" Binding="{Binding LOGON_TIME, StringFormat='{}{0:dd.MM.yy HH:mm}'}" Width="120"/>
                <DataGridTextColumn Header="Prozess-ID" Binding="{Binding PROCESS_ID}" Width="80"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>

          <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#DDD"/>

          <GroupBox Grid.Row="2" Header="SQL-Text und Bind-Variablen der ausgewählten Sitzung" Margin="0,5,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <avalonEdit:TextEditor Grid.Row="0"
                       Name="SqlEditorSitzungen"
                       SyntaxHighlighting="SQL"
                       ShowLineNumbers="True"
                       IsReadOnly="True"
                       FontFamily="Consolas" FontSize="14"
                       Visibility="{Binding IsSqlVerfuegbar, Converter={StaticResource BoolToCollapsedConverter}}"/>
                
                <TextBlock Grid.Row="1"
                           Text="Hinweis: Kein aktives SQL für diese Sitzung gefunden."
                           Visibility="{Binding IsSqlVerfuegbar, Converter={StaticResource BoolInvertedToCollapsedConverter}}"
                           Margin="5" FontStyle="Italic" Foreground="Gray"/>

                <TextBox Grid.Row="2"
                         Text="{Binding AusgewaehlteSitzungBindVars, Mode=OneWay}"
                         Visibility="{Binding IsBindVarsVerfuegbar, Converter={StaticResource BoolToCollapsedConverter}}"
                         IsReadOnly="True" FontFamily="Consolas" FontSize="14"
                         Background="#F5F5F5" Margin="0,3,0,0" Height="40"
                         VerticalScrollBarVisibility="Auto" ToolTip="Bind-Variablen"/>
              </Grid>

              <StackPanel Grid.Column="1" Margin="5,0,0,0" Width="90">
                <CheckBox Content="Formatiert" 
                          IsChecked="{Binding IstSqlFormatiert}" 
                          Margin="0,0,0,5" ToolTip="Zwischen originalem und formatiertem SQL umschalten"/>

                <Button Content="Kopieren" 
                        Command="{Binding KopiereSitzungsSqlBefehl}" 
                        Margin="0,0,0,5"/>

                <Button Content="Session&#10;beenden"
                        Command="{Binding SitzungBeendenBefehl}"
                        Style="{StaticResource KillButtonStyle}"
                        Height="50"/>
              </StackPanel>
            </Grid>
          </GroupBox>
        </Grid>
      </TabItem>

      <!-- ═══════════════════════════════════════════════
           Tab 2: SQL-Historie (V$SQL)
           ═══════════════════════════════════════════════ -->
      <TabItem Header="SQL-Historie (V$SQL)">
        <Grid Margin="5">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
            <Button Content="SQL-Historie aktualisieren"
        Command="{Binding SqlAktualisierenBefehl}"
        Style="{StaticResource AnalysisButtonStyle}"/>
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <TextBox Width="150" Text="{Binding FilterTextSql, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StatusSql, Mode=OneWay}" Style="{StaticResource StatusTextStyle}" Margin="10,0,0,0"/>
          </StackPanel>

          <DataGrid Grid.Row="1" 
        ItemsSource="{Binding SqlVerlaufAnsicht}"
        SelectedItem="{Binding AusgewaehltesSql}"
        SelectionMode="Single"
        AutoGenerateColumns="False"
        IsReadOnly="True"
        SelectionUnit="FullRow"
        HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTextColumn Header="SQL-ID" Binding="{Binding SQL_ID}" Width="120"/>
              <DataGridTextColumn Header="Ausführungen" Binding="{Binding EXECUTIONS, StringFormat='{}{0:N0}'}" Width="110"/>
              <DataGridTextColumn Header="Disk Reads" Binding="{Binding DISK_READS, StringFormat='{}{0:N0}'}" Width="100"/>
              <DataGridTextColumn Header="Buffer Gets" Binding="{Binding BUFFER_GETS, StringFormat='{}{0:N0}'}" Width="100"/>
              <DataGridTextColumn Header="CPU-Zeit (µs)" Binding="{Binding CPU_TIME, StringFormat='{}{0:N0}'}" Width="110"/>
            </DataGrid.Columns>
          </DataGrid>

          <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="LightGray"/>

          <!-- SQL-Bereich mit Editor und Buttons -->
          <Grid Grid.Row="3" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <avalonEdit:TextEditor Grid.Column="0"
                 x:Name="SqlHistorieEditor"
                 SyntaxHighlighting="SQL"
                 ShowLineNumbers="True"
                 IsReadOnly="True"
                 FontFamily="Consolas" FontSize="14" />

            <StackPanel Grid.Column="1" Margin="5,0,0,0" Width="90">
              <CheckBox Content="Formatiert" 
                  IsChecked="{Binding IstSqlHistorieFormatiert}" 
                  Margin="0,0,0,5" 
                  ToolTip="Zwischen originalem und formatiertem SQL umschalten"/>

              <Button Content="Kopieren" 
                Command="{Binding KopiereHistorieSqlBefehl}" 
                Margin="0,0,0,5"/>
            </StackPanel>
          </Grid>
        </Grid>
      </TabItem>

      <!-- ═══════════════════════════════════════════════
           Tab 3: Prozesse (V$PROCESS)
           ═══════════════════════════════════════════════ -->
      <TabItem Header="Prozesse (V$PROCESS)">
        <DockPanel Margin="5">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
            <Button Content="Prozesse aktualisieren"
              Command="{Binding ProzesseAktualisierenBefehl}"
              Style="{StaticResource AnalysisButtonStyle}"/>

            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <TextBox Width="150" 
               Text="{Binding FilterTextProzesse, UpdateSourceTrigger=PropertyChanged}" 
               VerticalAlignment="Center"/>

            <TextBlock Text="{Binding StatusProzesse, Mode=OneWay}"
                 Style="{StaticResource StatusTextStyle}" Margin="10,0,0,0"/>
          </StackPanel>

          <DataGrid ItemsSource="{Binding ProzesseAnsicht}"
              SelectedItem="{Binding AusgewaehlterProzess}"
              AutoGenerateColumns="False"
              HeadersVisibility="Column"
              IsReadOnly="True"
              BorderThickness="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="PID" Binding="{Binding PID}" Width="60"/>
              <DataGridTextColumn Header="SPID" Binding="{Binding SPID}" Width="80"/>
              <DataGridTextColumn Header="ADDR" Binding="{Binding ADDR}" Width="120"/>
              <DataGridTextColumn Header="Background" Binding="{Binding BACKGROUND}" Width="80"/>
              <DataGridTextColumn Header="Benutzer" Binding="{Binding USERNAME}" Width="100"/>
              <DataGridTextColumn Header="Programm" Binding="{Binding PROGRAM}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- ═══════════════════════════════════════════════
           Tab 4: Datenbank-Jobs (Jobs)
           ═══════════════════════════════════════════════ -->
      <TabItem Header="Datenbank-Jobs">
        <DockPanel Margin="5">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
            <Button Content="Jobs aktualisieren"
              Command="{Binding JobsAktualisierenBefehl}"
              Style="{StaticResource AnalysisButtonStyle}"/>

            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <TextBox Width="150" 
               Text="{Binding FilterTextJobs, UpdateSourceTrigger=PropertyChanged}" 
               VerticalAlignment="Center"/>

            <TextBlock Text="{Binding StatusJobs, Mode=OneWay}"
                 Style="{StaticResource StatusTextStyle}" Margin="10,0,0,0"/>
          </StackPanel>

          <DataGrid ItemsSource="{Binding JobsAnsicht}"
              SelectedItem="{Binding AusgewaehlterJob}"
              AutoGenerateColumns="False"
              HeadersVisibility="Column"
              IsReadOnly="True"
              BorderThickness="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Job-Name" Binding="{Binding JOB_NAME}" Width="200"/>
              <DataGridTextColumn Header="Aktion" Binding="{Binding JOB_ACTION}" Width="*"/>
              <DataGridTextColumn Header="Status" Binding="{Binding STATUS}" Width="100"/>
              <DataGridTextColumn Header="Start-Datum" Binding="{Binding START_DATE}" Width="140"/>
              <DataGridTextColumn Header="Letzte Ausf." Binding="{Binding LAST_START_DATE}" Width="140"/>
              <DataGridTextColumn Header="Nächste Ausf." Binding="{Binding NEXT_RUN_DATE}" Width="140"/>
              <DataGridTextColumn Header="Wiederholung" Binding="{Binding REPEAT_INTERVAL}" Width="150"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- ═══════════════════════════════════════════════
           Tab 5: Sperren (V$LOCK)
           ═══════════════════════════════════════════════ -->
      <TabItem Header="Sperren (V$LOCK)">
        <Grid Margin="5">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="130"/>
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
              <Button Content="Sperren aktualisieren"
                Command="{Binding SperrenAktualisierenBefehl}"
                Style="{StaticResource AnalysisButtonStyle}"/>
              <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="10,0,5,0"/>
              <TextBox Width="150" 
                 Text="{Binding FilterTextSperren, UpdateSourceTrigger=PropertyChanged}" 
                 VerticalAlignment="Center"/>
              <TextBlock Text="{Binding StatusSperren, Mode=OneWay}"
                   Style="{StaticResource StatusTextStyle}" Margin="10,0,0,0"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding SperrenAnsicht}"
                SelectedItem="{Binding AusgewaehlteSperre}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                BorderThickness="0"
                SelectionUnit="FullRow"
                ClipboardCopyMode="IncludeHeader"
                GridLinesVisibility="Horizontal"
                AlternatingRowBackground="#FAFAFA"
                HeadersVisibility="Column">
              <DataGrid.Columns>
                <DataGridTextColumn Header="SID" Width="60" Binding="{Binding SID, StringFormat='{}{0:N0}'}">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource ZahlSpalteStyle}"/>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Serial" Width="65" Binding="{Binding SERIAL, StringFormat='{}{0:N0}'}">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource ZahlSpalteStyle}"/>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Benutzer"        Binding="{Binding USERNAME}"       Width="110"/>
                <DataGridTextColumn Header="OS-User"         Binding="{Binding OSUSER}"         Width="110"/>
                <DataGridTextColumn Header="Maschine"        Binding="{Binding MACHINE}"        Width="130"/>
                <DataGridTextColumn Header="Programm"        Binding="{Binding PROGRAM}"        Width="*"/>
                <DataGridTextColumn Header="Lock-Typ"        Binding="{Binding TYPE}"           Width="80"/>
                <DataGridTextColumn Header="Aktueller Modus" Binding="{Binding STATUS_AKTUELL}" Width="120"/>
                <DataGridTextColumn Header="Angefragt"       Binding="{Binding ANGEFRAGT}"      Width="100"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>

          <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#DDD"/>

          <GroupBox Grid.Row="2" Header="SQL-Text der blockierenden Session" Margin="0,5,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <Grid Grid.Column="0">
                <avalonEdit:TextEditor Name="SqlEditorSperren"
                                 SyntaxHighlighting="SQL"
                                 ShowLineNumbers="True"
                                 IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11"
                                 Visibility="{Binding IsSperreSqlVerfuegbar, Converter={StaticResource BoolToCollapsedConverter}}"/>

                <TextBlock Text="Hinweis: Kein aktives SQL für diese Sperre gefunden."
                     Visibility="{Binding IsSperreSqlVerfuegbar, Converter={StaticResource BoolInvertedToCollapsedConverter}}"
                     FontStyle="Italic" Foreground="Gray" 
                     VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Grid>

              <Button Grid.Column="1"
                Content="Session&#10;beenden"
                Command="{Binding SperreBeendenBefehl}"
                Style="{StaticResource KillButtonStyle}"
                Width="80"
                ToolTip="Session hinter der Sperre beenden (erfordert ALTER SYSTEM)"/>
            </Grid>
          </GroupBox>
        </Grid>
      </TabItem>

    </TabControl>

    <!-- ═══════════════════════════════════════════════════════════════════
         Statusleiste: Zeitstempel der letzten Aktualisierung (T-07)
         ═══════════════════════════════════════════════════════════════════ -->
    <Border Grid.Row="1"
        Background="#EEEEEE"
        Padding="8,3"
        BorderBrush="#CCCCCC"
        BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding GlobalerStatusText, Mode=OneWay}"
               Foreground="#757575" 
               FontSize="11"
               HorizontalAlignment="Left" 
               VerticalAlignment="Center"/>
    </Border>

  </Grid>
</UserControl>
