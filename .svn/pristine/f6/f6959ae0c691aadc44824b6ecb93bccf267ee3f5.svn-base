using Bsd.DbMonitorWPF.ViewModels;
using Microsoft.Extensions.DependencyInjection;

namespace Bsd.DbMonitorWPF
{
  public static class DiProvider
  {
    public static void InitDependencyInjectionForDbMonitorWPF(this ServiceCollection serviceCollection)
    {
      if (serviceCollection == null)
      {
        return;
      }

      // ViewModels
      serviceCollection.AddTransient<MainViewModel>();
    }
  }
}
