using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Data;
using System.Windows.Documents;
using System.Windows.Input;
using System.Windows.Media;
using System.Windows.Media.Imaging;
using System.Windows.Navigation;
using System.Windows.Shapes;
using Bsd.DbMonitorWPF.ViewModels;

namespace Bsd.DbMonitorWPF.Views
{
  /// <summary>
  /// Interaktionslogik für AuditLogView.xaml
  /// </summary>
  public partial class AuditLogView : UserControl
  {
    public AuditLogView()
    {
      InitializeComponent();
      // Подпишемся на событие, которое сработает, когда вкладка откроется
      this.Loaded += AuditLogView_Loaded;
    }

    private void AuditLogView_Loaded(object sender, RoutedEventArgs e)
    {
      if (DataContext is AuditLogViewModel vm)
      {
        vm.LoadData();
      }
    }
  }
}
