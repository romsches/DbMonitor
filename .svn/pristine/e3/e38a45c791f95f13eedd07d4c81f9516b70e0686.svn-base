using System;
using System.Windows.Input;
using Bsd.Data.Helper;
using Bsd.DbMonitorWPF.ViewModels;
using Bsd.WPFObjects; // Здесь должен быть базовый класс
using Bsd.WPFObjects.Views;
using Microsoft.Extensions.Logging;

namespace Bsd.DbMonitorWPF.ViewModels
{
  // Если ViewModelBase не подходит, проверь, от чего наследуется MainViewModel
  // и используй тот же самый класс здесь.
  public class DashboardViewModel : DiViewModel
  {
    private readonly MainViewModel _mainViewModel;

    // Чтобы ошибки "не содержит определения" исчезли, 
    // убедись, что в MainViewModel эти свойства объявлены как public!
    public int AnzahlSitzungen => _mainViewModel.SitzungenVm?.Sitzungen?.Count ?? 0;
    public int AnzahlSperren => _mainViewModel.SperrenVm?.Sperren?.Count ?? 0;
    public int AnzahlAuffaelligeJobs => _mainViewModel.JobsVm?.AuffaelligeJobs?.Count ?? 0;
    public ICommand WechsleZuSitzungenBefehl => _mainViewModel.WechsleZuSitzungenBefehl;
    public ICommand WechsleZuJobsBefehl => _mainViewModel.WechsleZuJobsBefehl;
    public ICommand WechsleZuSperrenBefehl => _mainViewModel.WechsleZuSperrenBefehl;
    public ICommand LadeTopSqlBefehl => _mainViewModel.LadeTopSqlBefehl;
    public ICommand LadeTopProzesseBefehl => _mainViewModel.LadeTopProzesseBefehl;
    public DashboardViewModel(MainViewModel mainViewModel, IServiceProvider serviceProvider, IOraProvider oraProvider, ILogger<DashboardViewModel> log)
    : base(serviceProvider, oraProvider, log)
    {
      _mainViewModel = mainViewModel ?? throw new ArgumentNullException(nameof(mainViewModel));
    }

    public void Refresh()
    {
      OnPropertyChanged(nameof(AnzahlSitzungen));
      OnPropertyChanged(nameof(AnzahlSperren));
      OnPropertyChanged(nameof(AnzahlAuffaelligeJobs));
    }
  }
}
