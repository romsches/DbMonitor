<bsdwpf:BsdApplication x:Class="Bsd.DbMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Bsd.DbMonitor.Properties"
             xmlns:bsdwpf="clr-namespace:Bsd.WPFObjects.Apps;assembly=BSD_WPFObjects">
  <!--StartupUri="MainWindow.xaml">-->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/BSD_WPFObjects;component/SharedDictionary.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/DbMonitorWPF;component/LocalDictionary.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</bsdwpf:BsdApplication>
