using System;
using System.Collections.Generic;
using System.Collections.ObjectModel;
using System.ComponentModel;
using System.Windows.Data;
using System.Windows.Input;
using Bsd.Data.Entities;
using Bsd.Data.Helper;
using Bsd.DbMonitorData;
using Bsd.DbMonitorWPF.Helpers;
using Bsd.WPFObjects.Apps;
using Bsd.WPFObjects.Views;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Logging;
using Prism.Commands;

namespace Bsd.DbMonitorWPF.ViewModels
{
  public class ProzesseViewModel : DiViewModel
  {
    private readonly ILogger _log;
    private V_PROCESS _ausgewaehlterProzess;
    private string _filterTextProzesse;
    private string _statusProzesse;
    private bool _istTop20Modus = false;

    public bool IstTop20Modus => _istTop20Modus;

    public ICommand AlleProzesseLadenBefehl { get; }
    public ICommand LadeTopProzesseBefehl { get; }
    public ICommand ProzesseAktualisierenBefehl { get; }

    public ObservableCollection<V_PROCESS> Prozesse { get; }
    public ICollectionView ProzesseAnsicht { get; }

    public ProzesseViewModel(IServiceProvider serviceProvider, IOraProvider oraProvider, ILogger<ProzesseViewModel> log)
        : base(serviceProvider, oraProvider, log)
    {
      _log = log;
      Prozesse = new ObservableCollection<V_PROCESS>();
      ProzesseAnsicht = CollectionViewSource.GetDefaultView(Prozesse);
      ProzesseAnsicht.Filter = FilterProzesseDelegate;

      AlleProzesseLadenBefehl = new DelegateCommand(LadeAlleProzesseAusfuehren);
      LadeTopProzesseBefehl = new DelegateCommand(LadeTopProzesseAusfuehren);
      ProzesseAktualisierenBefehl = new DelegateCommand(ProzesseAktualisierenAusfuehren);
    }

    public V_PROCESS AusgewaehlterProzess
    {
      get => _ausgewaehlterProzess;
      set => SetObj(ref _ausgewaehlterProzess, value);
    }

    public string FilterTextProzesse
    {
      get => _filterTextProzesse;
      set { SetVal(ref _filterTextProzesse, value); ProzesseAnsicht?.Refresh(); }
    }

    public string StatusProzesse
    {
      get => _statusProzesse;
      set => SetVal(ref _statusProzesse, value);
    }

    private void ProzesseAktualisierenAusfuehren()
    {
      // Der Timer im MainViewModel ruft jetzt auch diese Logik auf.
      // Durch die Prüfung von _istTop20Modus bleibt der Modus erhalten.
      if (_istTop20Modus)
      {
        LadeTopProzesseAusfuehren();
      }
      else
      {
        LadeAlleProzesseAusfuehren();
      }
    }

    public void LadeTopProzesseAusfuehren()
    {
      _istTop20Modus = true;
      var dbQuery = ServiceProvider.GetService<DbQuery>();
      if (dbQuery == null) return;

      try
      {
        var liste = dbQuery.GetTopMemoryProcessesList() ?? new List<V_PROCESS>();
        BsdApplication.InvokeIfRequired(() =>
        {
          CollectionAktualisieren(Prozesse, liste);
          ProzesseAnsicht?.Refresh();
          StatusProzesse = StatusHelper.FormatStatus(liste.Count, "Top-Prozesse (nach Speicher)");
        });
      }
      catch (Exception ex)
      {
        _log.LogError(ex, "Fehler beim Laden der Top-Prozesse.");
        StatusProzesse = "Fehler beim Laden.";
      }
    }

    public void LadeAlleProzesseAusfuehren()
    {
      _istTop20Modus = false;
      var dbQuery = ServiceProvider.GetService<DbQuery>();
      if (dbQuery == null) return;

      var liste = dbQuery.GetAllProcessesList() ?? new List<V_PROCESS>();

      BsdApplication.InvokeIfRequired(() =>
      {
        CollectionAktualisieren(Prozesse, liste);
        ProzesseAnsicht?.Refresh();
        StatusProzesse = StatusHelper.FormatStatus(liste.Count, "Prozesse");
      });
    }

    private bool FilterProzesseDelegate(object obj)
    {
      if (string.IsNullOrWhiteSpace(FilterTextProzesse)) return true;
      if (obj is V_PROCESS p)
      {
        string f = FilterTextProzesse.Trim();
        return Enthaelt(p.USERNAME, f) || Enthaelt(p.PROGRAM, f) ||
               Enthaelt(p.BACKGROUND, f) || Enthaelt(p.SPID?.ToString(), f) ||
               Enthaelt(p.ADDR, f);
      }
      return false;
    }

    /// <summary>
    /// Aktualisiert die Daten der Prozesse-Collection ohne DB-Neuabruf.
    /// </summary>
    public void AktualisierenIntern(List<V_PROCESS> daten)
    {
      // 1. Benutze den Helper mit der korrekten Collection 'Prozesse'
      CollectionHelper.Sync(Prozesse, daten);

      // 2. Refresh der Ansicht
      ProzesseAnsicht?.Refresh();

      // 3. Status aktualisieren (beachte: Zugriff auf 'StatusProzesse', nicht StatusSitzungen)
      StatusProzesse = StatusHelper.FormatStatus(Prozesse.Count, "Prozesse");
    }
  }
}
