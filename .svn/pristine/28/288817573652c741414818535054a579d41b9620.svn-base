using System;
using System.Diagnostics;
using System.IO;
using System.Reflection;
using System.Windows;
using System.Windows.Input;
using Bsd.DbMonitorData;
using Bsd.DbMonitorWPF;
using Bsd.DbMonitorWPF.ViewModels;
using Bsd.DbMonitorWPF.Views;
using Bsd.SharedObjects;
using Bsd.SharedObjects.Assemblies;
using Bsd.WPFObjects;
using Bsd.WPFObjects.Apps;
using Bsd.WPFObjects.Apps.Menu;
using Bsd.WPFObjects.Events;
using Bsd.WPFObjects.Helper;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Logging;

namespace Bsd.DbMonitor
{
  /// <summary>
  /// Interaction logic for App.xaml
  /// </summary>
  public partial class App : BsdApplication
  {
    #region ctor

    public App() : base()
    {
      LogoffCommand = new RelayCommand(param => OnLogoffCommand());
      CloseCommand = new RelayCommand(param => OnCloseCommand());
      ReleaseNotesCommand = new RelayCommand(param => OnReleaseNotesCommand());
    }

    #endregion ctor

    #region events
    #endregion

    #region commands

    public ICommand LogoffCommand { get; private set; }
    public ICommand CloseCommand { get; private set; }
    public ICommand ReleaseNotesCommand { get; private set; }

    #endregion

    #region fields
    #endregion

    #region properties
    #endregion

    #region public methods

    #endregion

    #region override methods

    public override void ConfigureServices(ServiceCollection services)
    {
      services.InitDependencyInjectionForSharedObjects();
      services.InitDependencyInjectionForBsdBaWueHe();
      services.InitDependencyInjectionForWpfObjects();
      services.InitDependencyInjectionForDbMonitorData();
      services.InitDependencyInjectionForDbMonitorWPF();
    }

    public override void AppIsStarting(string[] arguments)
    {
      EventSystem.LoggingEnabled = Debugger.IsAttached;
    }

    public override void AppIsInitializating(string[] arguments)
    {
    }

    public override Window AppRequestsMainWindow()
    {
      // create main view model
      MainViewModel mainViewModel = ServiceProvider.GetService<MainViewModel>();
      // create main view with model
      MainView mainView = new MainView() { DataContext = mainViewModel };
      // create main window model
      MainWindowModel mainWindowModel = new MainWindowModel() { MainControl = mainView, WindowTitle = "DbMonitor" };
      AddMenuItems(mainWindowModel);
      // add main view to main window of application
      MainWindow mainWindow = new MainWindow() { DataContext = mainWindowModel };

      // T-11: Fenster beim Start maximieren
      mainWindow.WindowState = WindowState.Maximized;

      // return main window
      return mainWindow;
    }

    public override void AppMainWindowIsOpened()
    {
      EventSystem.Publish(new RefreshStatusLineEvent());
    }

    public override void AppIsExiting()
    {
    }

    #endregion override methods

    #region private methods

    private void AddMenuItems(MainWindowModel mainWindowModel)
    {
      // remove file menu
      MenuItemModel fileMenu = mainWindowModel.GetMenuItem("File");
      mainWindowModel.MainMenuModels.Remove(fileMenu);

      // workspace
      MenuItemModel workspaceModel = new MenuItemModel("Arbeitsplatz", "Workspace");
      mainWindowModel.MainMenuModels.Insert(0, workspaceModel);

      MenuItemModel logoffModel = new MenuItemModel("Abmelden", "Workspace/Logoff", "/BSD_WPFObjects;component/Icons/Key.png", LogoffCommand);
      workspaceModel.SubItems.Add(logoffModel);
      MenuItemModel closeModel = new MenuItemModel("Beenden", "Workspace/Close", "/BSD_WPFObjects;component/Icons/Beenden.png", CloseCommand);
      workspaceModel.SubItems.Add(closeModel);

      // help
      MenuItemModel help = mainWindowModel.GetMenuItem("Help");

      MenuItemModel releaseNotesModel = new MenuItemModel("Versionsinformationen", "Help/ReleaseNotes", "/BSD_WPFObjects;component/Icons/Dokument.png", ReleaseNotesCommand);
      help.SubItems.Insert(0, releaseNotesModel);
    }

    private void OnLogoffCommand()
    {
      Logger.LogInformation("Application logout");
      // logout
      EventSystem.Publish(new UserLoginEvent(LoginOperation.Logout, User.InterCode));
    }

    private void OnCloseCommand()
    {
      Logger.LogInformation("Application closing");

      MainWindowModel mainViewModel = BsdApplication.BsdCurrent.MainWindow.DataContext as MainWindowModel;
      mainViewModel?.CloseApplication(false);
    }

    private void OnReleaseNotesCommand()
    {
      string pdfName = "ReleaseNotes.pdf";
      LoadAndShowPdfDocument(pdfName, "Versionshistorie");
    }

    private void LoadAndShowPdfDocument(string pdfName, string titleBottom)
    {
      try
      {
        Assembly assembly = Assembly.GetExecutingAssembly();
        string assemblyFolder = new AssemblyInfoReader(assembly).AssemblyFolder;
        string pdfFilePath = Path.Combine(assemblyFolder, pdfName);

        ShowPdfDialog("DbMonitor", titleBottom, pdfFilePath);
      }
      catch (Exception ex)
      {
        Logger.LogError(ex, $"Loading PDF: {pdfName}");
      }
    }

    private void ShowPdfDialog(string titleTop, string titleBottom, string text)
    {
      ReleaseNotesViewModel viewModel = BsdApplication.BsdCurrent.ServiceProvider.GetService<ReleaseNotesViewModel>();
      viewModel.TitleTop = titleTop;
      viewModel.TitleBottom = titleBottom;
      viewModel.PdfFile = text;
      viewModel.ZoomValue = 1.5;
      viewModel.CloseAction = () =>
      {
        EventSystem.Publish(ShadableStackEvent.Pop("MainWindow"));
      };
      ReleaseNotesView view = new ReleaseNotesView() { DataContext = viewModel };
      EventSystem.Publish(ShadableStackEvent.Push(view, "MainWindow", true, true));
    }

    #endregion private methods
  }
}
