using System.Windows;
using System.Windows.Controls;
using System.Windows.Media;
using System.ComponentModel;
using Bsd.DbMonitorWPF.ViewModels;
using ICSharpCode.AvalonEdit.Highlighting;
using static SQL.Formatter.SqlFormatter;

namespace Bsd.DbMonitorWPF.Views
{
  public partial class MainView : UserControl
  {
    public MainView()
    {
      InitializeComponent();

    }

    private void CopySelectedCell_Click(object sender, RoutedEventArgs e)
    {
      if (sender is MenuItem menuItem && menuItem.Parent is ContextMenu contextMenu)
      {
        if (contextMenu.PlacementTarget is DataGridCell cell)
        {
          if (cell.Content is TextBlock textBlock)
          {
            Clipboard.SetText(textBlock.Text);
          }
          else if (cell.Content is string text)
          {
            Clipboard.SetText(text);
          }
        }
      }
    }
  }
}
