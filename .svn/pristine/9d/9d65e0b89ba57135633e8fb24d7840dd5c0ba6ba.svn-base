using System;
using System.Collections.Generic;
using System.Collections.ObjectModel;
using System.ComponentModel;
using System.Windows.Data;
using System.Windows.Input;
using Bsd.Data.Entities;
using Bsd.Data.Helper;
using Bsd.DbMonitorData;
using Bsd.DbMonitorWPF.Helpers;
using Bsd.WPFObjects.Apps;
using Bsd.WPFObjects.Views;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Logging;
using Prism.Commands;

namespace Bsd.DbMonitorWPF.ViewModels
{
  public class AuditLogViewModel : DiViewModel
  {
    private readonly DbQuery _dbQuery;
    private string _filterText = string.Empty;
    private string _status;

    public ObservableCollection<AuditLogEntry> AuditEntries { get; } = new ObservableCollection<AuditLogEntry>();
    public ICollectionView AuditLogAnsicht { get; }

    public string FilterText
    {
      get => _filterText;
      set { SetVal(ref _filterText, value); AuditLogAnsicht?.Refresh(); }
    }

    public string Status
    {
      get => _status;
      set => SetVal(ref _status, value);
    }

    public ICommand RefreshCommand { get; }

    public AuditLogViewModel(IServiceProvider serviceProvider, IOraProvider oraProvider, ILogger<AuditLogViewModel> log, DbQuery dbQuery)
        : base(serviceProvider, oraProvider, log)
    {
      _dbQuery = dbQuery;
      AuditLogAnsicht = CollectionViewSource.GetDefaultView(AuditEntries);
      AuditLogAnsicht.Filter = FilterAuditLog;
      RefreshCommand = new DelegateCommand(LoadData);
    }

    public void LoadData()
    {
      var data = _dbQuery.GetAuditLogEntries() ?? new List<AuditLogEntry>();

      BsdApplication.InvokeIfRequired(() =>
      {
        CollectionAktualisieren(AuditEntries, data);
        AuditLogAnsicht?.Refresh();

        // Используем "Einträge" или "Audit Logs", как тебе больше нравится. 
        // Главное, что StatusHelper уже настроен на "Gefunden: ..."
        Status = StatusHelper.FormatStatus(data.Count, "Audit Logs");
      });
    }

    private bool FilterAuditLog(object obj)
    {
      if (string.IsNullOrWhiteSpace(FilterText)) return true;
      if (obj is AuditLogEntry entry)
      {
        string f = FilterText.Trim();
        return Enthaelt(entry.DAL_USERNAME, f) ||
               Enthaelt(entry.DAL_REASON, f) ||
               Enthaelt(entry.DAL_PROGRAM, f) ||
               Enthaelt(entry.DAL_TERMINAL, f) ||
               Enthaelt(entry.DAL_OSUSER, f);
      }
      return false;
    }
  }
}
