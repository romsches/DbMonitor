<UserControl x:Class="Bsd.DbMonitorWPF.Views.SqlhistorieView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:avalonEdit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

  <Grid Margin="5">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="150"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
      <Button Content="Aktualisieren"
              Command="{Binding SqlAktualisierenBefehl}"
              Style="{StaticResource AnalysisButtonStyle}"
              Margin="0,0,10,0"/>

      <Button Content="Alle SQL" 
              Command="{Binding AlleSqlLadenBefehl}" 
              Style="{StaticResource AnalysisButtonStyle}"
              Margin="0,0,5,0"/>

      <Button Content="Top 20 SQL" 
              Command="{Binding LadeTopSqlBefehl}" 
              Style="{StaticResource AnalysisButtonStyle}"
              Margin="0,0,10,0"/>

      <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="5,0,5,0"/>
      <TextBox Width="150" Text="{Binding FilterTextSql, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding StatusSql, Mode=OneWay}" Style="{StaticResource StatusTextStyle}" Margin="10,0,0,0"/>
    </StackPanel>
    <DataGrid Grid.Row="1" 
              ItemsSource="{Binding SqlVerlaufAnsicht}"
              SelectedItem="{Binding AusgewaehltesSql}"
              SelectionMode="Single"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              SelectionUnit="FullRow"
              HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridTextColumn Header="SQL-ID" Binding="{Binding SQL_ID}" Width="120"/>
        <DataGridTextColumn Header="Ausführungen" Binding="{Binding EXECUTIONS, StringFormat='{}{0:N0}'}" Width="110"/>
        <DataGridTextColumn Header="Disk Reads" Binding="{Binding DISK_READS, StringFormat='{}{0:N0}'}" Width="100"/>
        <DataGridTextColumn Header="Buffer Gets" Binding="{Binding BUFFER_GETS, StringFormat='{}{0:N0}'}" Width="100"/>
        <DataGridTextColumn Header="CPU-Zeit (µs)" Binding="{Binding CPU_TIME, StringFormat='{}{0:N0}'}" Width="110"/>
      </DataGrid.Columns>
    </DataGrid>

    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="LightGray"/>

    <Grid Grid.Row="3" Margin="0,5,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <avalonEdit:TextEditor Grid.Column="0"
                             x:Name="SqlHistorieEditor"
                             SyntaxHighlighting="SQL"
                             ShowLineNumbers="True"
                             IsReadOnly="True"
                             FontFamily="Consolas" FontSize="14" />

      <StackPanel Grid.Column="1" Margin="5,0,0,0" Width="90">
        <CheckBox Content="Unformatiert"
                  IsChecked="{Binding IstSqlHistorieFormatiert, UpdateSourceTrigger=PropertyChanged}" 
                  Margin="0,0,0,5" 
                  ToolTip="Zwischen originalem und formatiertem SQL umschalten"/>

        <Button Content="Kopieren" 
                Command="{Binding KopiereHistorieSqlBefehl}" 
                Margin="0,0,0,5"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
