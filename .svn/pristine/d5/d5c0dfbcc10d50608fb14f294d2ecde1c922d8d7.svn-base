<UserControl x:Class="Bsd.DbMonitorWPF.Views.SperrenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

  <Grid Margin="5">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="130"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
        <Button Content="Sperren aktualisieren"
                        Command="{Binding SperrenAktualisierenBefehl}"
                        Style="{StaticResource AnalysisButtonStyle}"/>

        <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="10,0,5,0"/>
        <TextBox Width="150" 
                         Text="{Binding FilterTextSperren, UpdateSourceTrigger=PropertyChanged}" 
                         VerticalAlignment="Center"/>

        <TextBlock Text="{Binding StatusSperren, Mode=OneWay}"
                           Style="{StaticResource StatusTextStyle}" 
                           Margin="10,0,0,0"/>
      </StackPanel>

      <DataGrid ItemsSource="{Binding SperrenAnsicht}"
                      SelectedItem="{Binding AusgewaehlteSperre}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      BorderThickness="0"
                      SelectionUnit="FullRow"
                      ClipboardCopyMode="IncludeHeader"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#FAFAFA"
                      HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTextColumn Header="SID" Width="60" Binding="{Binding SID, StringFormat='{}{0:N0}'}" ElementStyle="{StaticResource ZahlSpalteStyle}"/>
          <DataGridTextColumn Header="Serial" Width="65" Binding="{Binding SERIAL, StringFormat='{}{0:N0}'}" ElementStyle="{StaticResource ZahlSpalteStyle}"/>
          <DataGridTextColumn Header="Benutzer"        Binding="{Binding USERNAME}"       Width="110"/>
          <DataGridTextColumn Header="OS-User"         Binding="{Binding OSUSER}"         Width="110"/>
          <DataGridTextColumn Header="Maschine"        Binding="{Binding MACHINE}"        Width="130"/>
          <DataGridTextColumn Header="Programm"        Binding="{Binding PROGRAM}"        Width="*"/>
          <DataGridTextColumn Header="Lock-Typ"        Binding="{Binding TYPE}"           Width="80"/>
          <DataGridTextColumn Header="Aktueller Modus" Binding="{Binding STATUS_AKTUELL}" Width="120"/>
          <DataGridTextColumn Header="Angefragt"       Binding="{Binding ANGEFRAGT}"      Width="100"/>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

    <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#DDD"/>

    <GroupBox Grid.Row="2" Header="SQL-Text der blockierenden Session" Margin="0,5,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <avalonEdit:TextEditor Name="SqlEditorSperren"
                                           SyntaxHighlighting="SQL"
                                           ShowLineNumbers="True"
                                           IsReadOnly="True"
                                           FontFamily="Consolas" FontSize="11"
                                           Visibility="{Binding IsSperreSqlVerfuegbar, Converter={StaticResource BoolToCollapsedConverter}}"/>

          <TextBlock Text="Hinweis: Kein aktives SQL für diese Sperre gefunden."
                               Visibility="{Binding IsSperreSqlVerfuegbar, Converter={StaticResource BoolInvertedToCollapsedConverter}}"
                               FontStyle="Italic" Foreground="Gray" 
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>

        <Button Grid.Column="1"
                        Content="Session&#10;beenden"
                        Command="{Binding SperreBeendenBefehl}"
                        Style="{StaticResource KillButtonStyle}"
                        Width="80"
                        ToolTip="Session hinter der Sperre beenden (erfordert ALTER SYSTEM)"/>
      </Grid>
    </GroupBox>
  </Grid>
</UserControl>
