using System.Windows;
using System.Windows.Controls;
using System.Windows.Media;
using System.ComponentModel;
using Bsd.DbMonitorWPF.ViewModels;
using ICSharpCode.AvalonEdit.Highlighting;
using static SQL.Formatter.SqlFormatter;

namespace Bsd.DbMonitorWPF.Views
{
  public partial class MainView : UserControl
  {
    public MainView()
    {
      InitializeComponent();

      ApplySqlHighlighting(SqlEditorSitzungen);
      ApplySqlHighlighting(SqlHistorieEditor);
      ApplySqlHighlighting(SqlEditorSperren);

      this.DataContextChanged += OnDataContextChanged;
    }
    private void OnDataContextChanged(object sender, DependencyPropertyChangedEventArgs e)
    {
      var vm = this.DataContext as MainViewModel;
      if (vm == null) return;

      vm.PropertyChanged += (s, args) =>
      {
        // 1. Sitzungen
        if (args.PropertyName == nameof(MainViewModel.AktuellerSitzungSqlText))
          UpdateSqlEditor(SqlEditorSitzungen, vm.AktuellerSitzungSqlText);

        // 2. Sperren
        if (args.PropertyName == nameof(MainViewModel.AusgewaehlteSperreSql))
          UpdateSqlEditor(SqlEditorSperren, vm.AusgewaehlteSperreSql);

        // 3. SQL-Historie: Теперь реагируем на AktuellerHistorieSqlText
        if (args.PropertyName == nameof(MainViewModel.AktuellerHistorieSqlText))
        {
          UpdateSqlEditor(SqlHistorieEditor, vm.AktuellerHistorieSqlText);
        }
      };
    }
    private void UpdateSqlHistorieEditor(string sqlText)
    {
      if (SqlHistorieEditor != null)
      {
        SqlHistorieEditor.Text = FormatiereSql(sqlText);
      }
    }

    private void UpdateSqlEditor(ICSharpCode.AvalonEdit.TextEditor editor, string sqlText)
    {
      if (editor == null) return;

      editor.Text = FormatiereSql(sqlText);

      if (editor.SyntaxHighlighting == null)
      {
        var sqlHighlighting = HighlightingManager.Instance.GetDefinition("SQL");
        if (sqlHighlighting != null)
        {
          editor.SyntaxHighlighting = sqlHighlighting;
        }
        else
        {
          editor.SyntaxHighlighting = HighlightingManager.Instance.GetDefinition("TSQL");
        }
      }
    }
    private string FormatiereSql(string sql)
    {
      if (string.IsNullOrWhiteSpace(sql)) return string.Empty;

      return Format(sql);
    }
    private void ApplySqlHighlighting(ICSharpCode.AvalonEdit.TextEditor editor)
    {
      if (editor == null) return;

      var definition = HighlightingManager.Instance.GetDefinition("SQL");
      if (definition != null)
      {
        editor.SyntaxHighlighting = definition;
      }
      else
      {
        editor.SyntaxHighlighting = HighlightingManager.Instance.GetDefinition("TSQL");
      }
    }
  }
}
