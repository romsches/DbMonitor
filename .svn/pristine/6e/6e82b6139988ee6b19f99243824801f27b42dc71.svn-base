<UserControl x:Class="Bsd.DbMonitorWPF.Views.SitzungenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit">

  <Grid Margin="5">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="170"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
        <Button Content="Sitzungen aktualisieren"
                        Command="{Binding SitzungenAktualisierenBefehl}"
                        Style="{StaticResource AnalysisButtonStyle}"/>
        <Label Content="Filter:" VerticalAlignment="Center" Margin="10,0,0,0"/>
        <TextBox Text="{Binding FilterTextSitzungen, UpdateSourceTrigger=PropertyChanged}"
                         Width="180" VerticalAlignment="Center" Margin="5,0,0,0"
                         ToolTip="Sucht in: User, OS-User, Maschine, Terminal, Programm, Status, SID, Prozess-ID, Serial, Anmeldung"/>
        <TextBlock Text="{Binding StatusSitzungen, Mode=OneWay}"
                           Style="{StaticResource StatusTextStyle}"/>
      </StackPanel>

      <DataGrid ItemsSource="{Binding Sitzungen}"
                      SelectedItem="{Binding AusgewaehlteSitzung}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      BorderThickness="0"
                      SelectionUnit="FullRow"
                      ClipboardCopyMode="IncludeHeader"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#FAFAFA"
                      HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTextColumn Header="SID" Width="60" Binding="{Binding SID, StringFormat='{}{0:N0}'}">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock" BasedOn="{StaticResource ZahlSpalteStyle}"/>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Serial" Width="65" Binding="{Binding SERIAL, StringFormat='{}{0:N0}'}">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock" BasedOn="{StaticResource ZahlSpalteStyle}"/>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Benutzer" Width="110" Binding="{Binding USERNAME}">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="FontWeight" Value="Normal"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding USERNAME}" Value="SYSDRK">
                    <Setter Property="Foreground" Value="DarkRed"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding USERNAME}" Value="SYSADM">
                    <Setter Property="Foreground" Value="DarkBlue"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding USERNAME}" Value="SYSMON">
                    <Setter Property="Foreground" Value="DarkGreen"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="OS-User"   Binding="{Binding OSUSER}"    Width="110"/>
          <DataGridTextColumn Header="Maschine"  Binding="{Binding MACHINE}"   Width="130"/>
          <DataGridTextColumn Header="Terminal"  Binding="{Binding TERMINAL}"  Width="90"/>
          <DataGridTextColumn Header="Programm"  Binding="{Binding PROGRAM}"   Width="*"/>
          <DataGridTextColumn Header="Status"    Binding="{Binding STATUS}"    Width="80"/>
          <DataGridTextColumn Header="Typ"       Binding="{Binding TYPE}"      Width="70"/>
          <DataGridTextColumn Header="Anmeldung" Binding="{Binding LOGON_TIME, StringFormat='{}{0:dd.MM.yy HH:mm}'}" Width="120"/>
          <DataGridTextColumn Header="Prozess-ID" Binding="{Binding PROCESS_ID}" Width="80"/>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

    <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#DDD"/>

    <GroupBox Grid.Row="2" Header="SQL-Text und Bind-Variablen der ausgewählten Sitzung" Margin="0,5,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <avalonEdit:TextEditor Grid.Row="0" Name="SqlEditorSitzungen" SyntaxHighlighting="SQL" ShowLineNumbers="True" IsReadOnly="True" FontFamily="Consolas" FontSize="14" Visibility="{Binding IsSqlVerfuegbar, Converter={StaticResource BoolToCollapsedConverter}}"/>
          <TextBlock Grid.Row="1" Text="Hinweis: Kein aktives SQL für diese Sitzung gefunden." Visibility="{Binding IsSqlVerfuegbar, Converter={StaticResource BoolInvertedToCollapsedConverter}}" Margin="5" FontStyle="Italic" Foreground="Gray"/>
          <TextBox Grid.Row="2" Text="{Binding AusgewaehlteSitzungBindVars, Mode=OneWay}" Visibility="{Binding IsBindVarsVerfuegbar, Converter={StaticResource BoolToCollapsedConverter}}" IsReadOnly="True" FontFamily="Consolas" FontSize="14" Background="#F5F5F5" Margin="0,3,0,0" Height="40" VerticalScrollBarVisibility="Auto" ToolTip="Bind-Variablen"/>
        </Grid>

        <Grid Grid.Column="1" Margin="5,0,0,0" Width="90">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <CheckBox Grid.Row="0" Content="Unformatiert (Rohdaten)" IsChecked="{Binding IstSqlFormatiert}" Margin="0,0,0,5" ToolTip="Zwischen originalem und formatiertem SQL umschalten"/>
          <Button Grid.Row="1" Content="Kopieren" Command="{Binding KopiereSitzungsSqlBefehl}" Margin="0,0,0,5"/>
          <Button Grid.Row="2" Content="Session&#10;beenden" Command="{Binding SitzungBeendenBefehl}" Style="{StaticResource KillButtonStyle}" VerticalAlignment="Stretch"/>
        </Grid>
      </Grid>
    </GroupBox>
  </Grid>
</UserControl>
