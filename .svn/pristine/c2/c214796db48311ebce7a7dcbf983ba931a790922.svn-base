using System.Windows;
using System.Windows.Controls;
using System.Windows.Data;

namespace Bsd.DbMonitorWPF.Helpers
{
  public static class CellCopyHelper
  {
    public static void CopyCell_Click(object sender, RoutedEventArgs e)
    {
      if (sender is MenuItem menuItem && menuItem.Parent is ContextMenu contextMenu)
      {
        if (contextMenu.PlacementTarget is DataGridCell cell)
        {
          string text = string.Empty;

          // Пытаемся получить текст напрямую из TextBlock (стандартное поведение)
          if (cell.Content is TextBlock tb)
          {
            text = tb.Text;
          }
          // Если контент — это не TextBlock (например, ContentPresenter), 
          // пробуем привести к строке
          else if (cell.Content != null)
          {
            text = cell.Content.ToString();
          }

          if (!string.IsNullOrEmpty(text))
          {
            try
            {
              Clipboard.SetText(text);
            }
            catch
            {
              // Игнорируем ошибки доступа к буферу обмена
            }
          }
        }
      }
    }
  }
}
