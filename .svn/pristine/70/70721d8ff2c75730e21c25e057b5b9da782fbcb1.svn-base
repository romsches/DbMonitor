using System.ComponentModel;
using System.Windows.Controls;
using Bsd.DbMonitorWPF.ViewModels;
using ICSharpCode.AvalonEdit.Highlighting;
using ICSharpCode.AvalonEdit;

namespace Bsd.DbMonitorWPF.Views
{
  /// <summary>
  /// Code-Behind für die SqlhistorieView.
  /// Verantwortlich für die initiale Konfiguration des SQL-Editors und die Synchronisation 
  /// mit dem zugehörigen ViewModel.
  /// </summary>
  public partial class SqlhistorieView : UserControl
  {
    #region Konstruktor

    /// <summary>
    /// Initialisiert eine neue Instanz der <see cref="SqlhistorieView"/> Klasse.
    /// </summary>
    public SqlhistorieView()
    {
      InitializeComponent();
      ApplySqlHighlighting(SqlHistorieEditor);

      this.Loaded += OnViewLoaded;
      this.DataContextChanged += OnDataContextChanged;
    }

    #endregion

    #region Event-Handler

    /// <summary>
    /// Wird aufgerufen, sobald das Control geladen wurde.
    /// Löst den initialen Datenabruf aus.
    /// </summary>
    private void OnViewLoaded(object sender, System.Windows.RoutedEventArgs e)
    {
      if (DataContext is SqlhistorieViewModel vm)
      {
        vm.SqlAktualisierenBefehl.Execute(null);
      }
    }

    /// <summary>
    /// Reagiert auf Änderungen des DataContext, um Property-Bindings manuell zu verwalten.
    /// </summary>
    private void OnDataContextChanged(object sender, System.Windows.DependencyPropertyChangedEventArgs e)
    {
      if (e.OldValue is SqlhistorieViewModel oldVm)
      {
        oldVm.PropertyChanged -= Vm_PropertyChanged;
      }

      if (e.NewValue is SqlhistorieViewModel newVm)
      {
        newVm.PropertyChanged += Vm_PropertyChanged;
        UpdateEditorContent(newVm);
      }
    }

    /// <summary>
    /// Verarbeitet Property-Änderungen des ViewModels, insbesondere zur Aktualisierung des SQL-Textes.
    /// </summary>
    private void Vm_PropertyChanged(object sender, PropertyChangedEventArgs e)
    {
      if (sender is SqlhistorieViewModel vm && e.PropertyName == nameof(SqlhistorieViewModel.AktuellerHistorieSqlText))
      {
        UpdateEditorContent(vm);
      }
    }

    #endregion

    #region Private Methoden

    /// <summary>
    /// Aktualisiert den Inhalt des TextEditors mit dem aktuellen SQL-Text aus dem ViewModel.
    /// </summary>
    /// <param name="vm">Das aktuelle SqlhistorieViewModel.</param>
    private void UpdateEditorContent(SqlhistorieViewModel vm)
    {
      SqlHistorieEditor.Text = vm.AktuellerHistorieSqlText ?? string.Empty;

      if (SqlHistorieEditor.SyntaxHighlighting == null)
      {
        ApplySqlHighlighting(SqlHistorieEditor);
      }
    }

    /// <summary>
    /// Wendet das SQL-Syntax-Highlighting auf den angegebenen Editor an.
    /// </summary>
    /// <param name="editor">Die AvalonEdit TextEditor-Instanz.</param>
    private void ApplySqlHighlighting(TextEditor editor)
    {
      editor.SyntaxHighlighting = HighlightingManager.Instance.GetDefinition("SQL")
                               ?? HighlightingManager.Instance.GetDefinition("TSQL");
    }

    #endregion
  }
}
