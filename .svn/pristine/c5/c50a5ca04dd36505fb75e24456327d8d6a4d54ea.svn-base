using System.ComponentModel;
using System.Windows;
using System.Windows.Controls;
using Bsd.DbMonitorWPF.ViewModels;
using ICSharpCode.AvalonEdit.Highlighting;
using ICSharpCode.AvalonEdit;
using static SQL.Formatter.SqlFormatter;

namespace Bsd.DbMonitorWPF.Views
{
  /// <summary>
  /// Code-Behind für die SperrenView.
  /// Handhabt die Anzeige von Datenbank-Sperren und die Formatierung der zugehörigen SQL-Anweisungen.
  /// </summary>
  public partial class SperrenView : UserControl
  {
    #region Konstruktor

    /// <summary>
    /// Initialisiert eine neue Instanz der <see cref="SperrenView"/> Klasse.
    /// </summary>
    public SperrenView()
    {
      InitializeComponent();
      ApplySqlHighlighting(SqlEditorSperren);

      this.Loaded += OnViewLoaded;
      this.DataContextChanged += OnDataContextChanged;
    }

    #endregion

    #region Event-Handler

    /// <summary>
    /// Löst beim Laden der View einen initialen Aktualisierungsvorgang aus.
    /// </summary>
    private void OnViewLoaded(object sender, RoutedEventArgs e)
    {
      if (DataContext is SperrenViewModel vm)
      {
        vm.SperrenAktualisierenBefehl.Execute(null);
      }
    }

    /// <summary>
    /// Verwaltet die Synchronisation bei einem Wechsel des DataContext.
    /// </summary>
    private void OnDataContextChanged(object sender, DependencyPropertyChangedEventArgs e)
    {
      if (e.OldValue is SperrenViewModel oldVm)
      {
        oldVm.PropertyChanged -= Vm_PropertyChanged;
      }

      if (e.NewValue is SperrenViewModel newVm)
      {
        newVm.PropertyChanged += Vm_PropertyChanged;
        UpdateSqlEditor(SqlEditorSperren, newVm.AusgewaehlteSperreSql);
      }
    }

    /// <summary>
    /// Reagiert auf Property-Änderungen im ViewModel zur Aktualisierung der SQL-Anzeige.
    /// </summary>
    private void Vm_PropertyChanged(object sender, PropertyChangedEventArgs e)
    {
      if (sender is SperrenViewModel vm && e.PropertyName == nameof(SperrenViewModel.AusgewaehlteSperreSql))
      {
        UpdateSqlEditor(SqlEditorSperren, vm.AusgewaehlteSperreSql);
      }
    }

    #endregion

    #region Private Methoden

    /// <summary>
    /// Formatiert den SQL-Text und aktualisiert den Editor-Inhalt.
    /// </summary>
    /// <param name="editor">Die AvalonEdit TextEditor-Instanz.</param>
    /// <param name="sqlText">Der anzuzeigende SQL-Code.</param>
    private void UpdateSqlEditor(TextEditor editor, string sqlText)
    {
      if (editor == null) return;

      // SQL-Text mittels SqlFormatter formatieren
      editor.Text = string.IsNullOrWhiteSpace(sqlText) ? string.Empty : Format(sqlText);

      // Syntax-Highlighting sicherstellen
      if (editor.SyntaxHighlighting == null)
      {
        ApplySqlHighlighting(editor);
      }
    }

    /// <summary>
    /// Wendet das SQL-Syntax-Highlighting auf den Editor an.
    /// </summary>
    /// <param name="editor">Die AvalonEdit TextEditor-Instanz.</param>
    private void ApplySqlHighlighting(TextEditor editor)
    {
      editor.SyntaxHighlighting = HighlightingManager.Instance.GetDefinition("SQL")
                               ?? HighlightingManager.Instance.GetDefinition("TSQL");
    }

    #endregion
  }
}
