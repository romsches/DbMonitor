using System.Collections.Generic;
using System.Collections.ObjectModel;

namespace Bsd.DbMonitorWPF.Helpers
{
  /// <summary>
  /// Stellt Hilfsmethoden für die effiziente Synchronisation von Datenkollektionen bereit.
  /// </summary>
  public static class CollectionHelper
  {
    /// <summary>
    /// Synchronisiert eine <see cref="ObservableCollection{T}"/> mit einer neuen Datenliste.
    /// Alle vorhandenen Elemente werden entfernt und durch die neuen Elemente ersetzt.
    /// </summary>
    /// <typeparam name="T">Der Typ der Elemente.</typeparam>
    /// <param name="collection">Die zu aktualisierende ObservableCollection.</param>
    /// <param name="daten">Die Liste der neuen Daten.</param>
    public static void Sync<T>(ObservableCollection<T> collection, List<T> daten)
    {
      if (collection == null || daten == null) return;

      collection.Clear();

      foreach (var item in daten)
      {
        collection.Add(item);
      }
    }
  }
}
