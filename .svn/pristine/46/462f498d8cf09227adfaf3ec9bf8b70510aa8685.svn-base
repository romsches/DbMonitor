using System.Windows;
using System.Windows.Controls;
using Bsd.DbMonitorWPF.ViewModels;

namespace Bsd.DbMonitorWPF.Views
{
  /// <summary>
  /// Code-Behind für die ProzesseView.
  /// Verantwortlich für die Anzeige der aktiven Oracle-Prozesse.
  /// </summary>
  public partial class ProzesseView : UserControl
  {
    #region Konstruktor

    /// <summary>
    /// Initialisiert eine neue Instanz der <see cref="ProzesseView"/> Klasse.
    /// </summary>
    public ProzesseView()
    {
      InitializeComponent();

      this.Loaded += OnViewLoaded;
    }

    #endregion

    #region Event-Handler

    /// <summary>
    /// Löst beim Laden der View den initialen Aktualisierungsbefehl aus.
    /// </summary>
    private void OnViewLoaded(object sender, RoutedEventArgs e)
    {
      if (DataContext is ProzesseViewModel vm)
      {
        vm.ProzesseAktualisierenBefehl.Execute(null);
      }
    }

    #endregion
  }
}
