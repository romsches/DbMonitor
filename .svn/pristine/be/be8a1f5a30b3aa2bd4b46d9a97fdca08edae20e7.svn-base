using System.Windows;
using System.Windows.Controls;
using Bsd.DbMonitorWPF.ViewModels;

namespace Bsd.DbMonitorWPF.Views
{
  /// <summary>
  /// Code-Behind für die AuditLogView.
  /// Zuständig für die Anzeige und Filterung der Audit-Protokolle der Datenbank.
  /// </summary>
  public partial class AuditLogView : UserControl
  {
    #region Konstruktor

    /// <summary>
    /// Initialisiert eine neue Instanz der <see cref="AuditLogView"/> Klasse.
    /// </summary>
    public AuditLogView()
    {
      InitializeComponent();
      this.Loaded += OnViewLoaded;
    }

    #endregion

    #region Event-Handler

    /// <summary>
    /// Löst beim Laden der View den initialen Aktualisierungsbefehl aus.
    /// </summary>
    private void OnViewLoaded(object sender, RoutedEventArgs e)
    {
      if (DataContext is AuditLogViewModel vm)
      {
        vm.RefreshCommand.Execute(null);
      }
    }

    #endregion
  }
}
