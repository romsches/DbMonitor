    #endregion

    #region Öffentliche Methoden – V$LOCK

    /// <summary>
    /// Ruft alle aktiven Transaktionssperren (TX-Locks) aus V$LOCK ab.
    /// DECODE wandelt numerische lmode/request-Codes in lesbare Bezeichnungen um.
    /// Sortiert nach SID für konsistente Darstellung.
    /// </summary>
    /// <returns>Liste aktiver TX-Sperren mit vollständigen Sitzungs- und Lock-Informationen.</returns>
    public List<V_LOCK> GetLockList()
    {
      var liste = new List<V_LOCK>();

      if (OraProvider?.OraController?.OracleConnection == null)
      {
        Logger.LogWarning("GetLockList: Datenbankverbindung ist nicht initialisiert.");
        return liste;
      }

      const string sql = @"
    SELECT DISTINCT
           s.sid,
           s.serial# AS serial,
           s.username,
           s.osuser,
           s.machine,
           s.terminal,
           s.program,
           s.status,
           s.logon_time,
           s.type AS session_type,
           l.id1,
           l.type,
           DECODE(l.lmode, 0, 'Waiting', 1, 'Null', 2, 'Row Shr', 3, 'Row Exc', 4, 'Share', 5, 'Shr Row X', 6, 'Exclusive', TO_CHAR(l.lmode)) AS status_aktuell,
           DECODE(l.request, 0, 'None', 1, 'Null', 2, 'Row Shr', 3, 'Row Exc', 4, 'Share', 5, 'Shr Row X', 6, 'Exclusive', TO_CHAR(l.request)) AS angefragt
    FROM v$session s
    JOIN v$lock l ON s.sid = l.sid
    WHERE l.type = 'TX'
    ORDER BY s.sid";

      try
      {
        using (var befehl = new OracleCommand(sql, OraProvider.OraController.OracleConnection))
        using (var leser = befehl.ExecuteReader())
        {
          while (leser.Read())
          {
            liste.Add(new V_LOCK
            {
              SID = leser["SID"] != DBNull.Value ? Convert.ToDecimal(leser["SID"]) : 0,
              SERIAL = leser["SERIAL"] != DBNull.Value ? Convert.ToDecimal(leser["SERIAL"]) : 0,
              USERNAME = leser["USERNAME"]?.ToString(),
              OSUSER = leser["OSUSER"]?.ToString(),
              MACHINE = leser["MACHINE"]?.ToString(),
              PROGRAM = leser["PROGRAM"]?.ToString(),
              ID1 = leser["ID1"]?.ToString(),
              TYPE = leser["TYPE"]?.ToString(),
              STATUS_AKTUELL = leser["STATUS_AKTUELL"]?.ToString(),
              ANGEFRAGT = leser["ANGEFRAGT"]?.ToString(),
              LOGON_TIME = leser["LOGON_TIME"] != DBNull.Value ? (DateTime?)Convert.ToDateTime(leser["LOGON_TIME"]) : null,
              STATUS = leser["STATUS"]?.ToString(),
              TERMINAL = leser["TERMINAL"]?.ToString(),
              SESSION_TYPE = leser["SESSION_TYPE"]?.ToString()
            });
          }
        }

        Logger.LogDebug("GetLockList: {Anzahl} Sperren gefunden.", liste.Count);
      }
      catch (Exception ausnahme)
      {
        Logger.LogError(ausnahme, "Fehler in GetLockList.");
      }

      return liste;
    }

    #endregion

    #region Öffentliche Methoden – DBA_SCHEDULER_JOBS

    /// <summary>
    /// Ruft alle aktiven Scheduler-Jobs des Benutzers SYSADM ab.
    /// Filter: owner = 'SYSADM' AND state != 'DISABLED'.
    /// Erweiterte Spalten: job_action, start_date, repeat_interval,
    ///   failure_count, last_start_date.
    /// Sortiert nach nächstem Ausführungszeitpunkt aufsteigend.
    /// </summary>
    /// <returns>Liste aller aktiven SYSADM Scheduler-Jobs.</returns>
    public List<V_JOB> GetJobList()
    {
      var liste = new List<V_JOB>();

      if (OraProvider?.OraController?.OracleConnection == null)
      {
        Logger.LogWarning("GetJobList: Datenbankverbindung ist nicht initialisiert.");
        return liste;
      }

      const string sql = @"
          SELECT job_name, job_type, job_action,
                 start_date, repeat_interval,
                 enabled, state,
                 run_count, failure_count,
                 last_start_date, last_run_duration,
                 next_run_date, comments
          FROM   dba_scheduler_jobs
          WHERE  owner = 'SYSADM'
          AND    state != 'DISABLED'
          ORDER BY next_run_date ASC";

      try
      {
        using (var befehl = new OracleCommand(sql, OraProvider.OraController.OracleConnection))
        using (var leser = befehl.ExecuteReader())
        {
          while (leser.Read())
          {
            liste.Add(new V_JOB
            {
              JOB_NAME = leser["JOB_NAME"]?.ToString(),
              JOB_TYPE = leser["JOB_TYPE"]?.ToString(),
              JOB_ACTION = leser["JOB_ACTION"]?.ToString(),
              START_DATE = leser["START_DATE"] != DBNull.Value ? (DateTime?)Convert.ToDateTime(leser["START_DATE"]) : null,
              REPEAT_INTERVAL = leser["REPEAT_INTERVAL"]?.ToString(),
              ENABLED = leser["ENABLED"]?.ToString(),
              STATE = leser["STATE"]?.ToString(),
              RUN_COUNT = leser["RUN_COUNT"] != DBNull.Value ? Convert.ToDecimal(leser["RUN_COUNT"]) : 0,
              FAILURE_COUNT = leser["FAILURE_COUNT"] != DBNull.Value ? Convert.ToDecimal(leser["FAILURE_COUNT"]) : 0,
              LAST_START_DATE = leser["LAST_START_DATE"] != DBNull.Value ? (DateTime?)Convert.ToDateTime(leser["LAST_START_DATE"]) : null,
              LAST_RUN_DURATION = leser["LAST_RUN_DURATION"]?.ToString(),
              NEXT_RUN_DATE = leser["NEXT_RUN_DATE"] != DBNull.Value ? (DateTime?)Convert.ToDateTime(leser["NEXT_RUN_DATE"]) : null,
              COMMENTS = leser["COMMENTS"]?.ToString()
            });
          }
        }

        Logger.LogDebug("GetJobList: {Anzahl} Jobs geladen.", liste.Count);
      }
      catch (Exception ausnahme)
      {
        Logger.LogError(ausnahme, "Fehler in GetJobList.");
      }

      return liste;
    }

    /// <summary>
    /// Dashboard-Abfrage: Nur Jobs mit kritischem Status.
    /// Filter: owner = 'SYSADM' AND state IN ('BROKEN', 'FAILED', 'STOPPED').
    /// Wird auf der orangefarbenen Dashboard-Karte als Warnanzeige dargestellt.
    /// </summary>
    /// <returns>Liste aller Jobs mit kritischem Ausführungsstatus.</returns>
    public List<V_JOB> GetAuffaelligeJobList()
    {
      var liste = new List<V_JOB>();

      if (OraProvider?.OraController?.OracleConnection == null)
      {
        Logger.LogWarning("GetAuffaelligeJobList: Datenbankverbindung ist nicht initialisiert.");
        return liste;
      }

      const string sql = @"
          SELECT job_name, job_type, state,
                 run_count, failure_count,
                 last_start_date, last_run_duration, comments
          FROM   dba_scheduler_jobs
          WHERE  owner = 'SYSADM'
          AND    state IN ('BROKEN', 'FAILED', 'STOPPED')
          ORDER BY state ASC, job_name ASC";

      try
      {
        using (var befehl = new OracleCommand(sql, OraProvider.OraController.OracleConnection))
        using (var leser = befehl.ExecuteReader())
        {
          while (leser.Read())
          {
            liste.Add(new V_JOB
            {
              JOB_NAME = leser["JOB_NAME"]?.ToString(),
              JOB_TYPE = leser["JOB_TYPE"]?.ToString(),
              STATE = leser["STATE"]?.ToString(),
              RUN_COUNT = leser["RUN_COUNT"] != DBNull.Value ? Convert.ToDecimal(leser["RUN_COUNT"]) : 0,
              FAILURE_COUNT = leser["FAILURE_COUNT"] != DBNull.Value ? Convert.ToDecimal(leser["FAILURE_COUNT"]) : 0,
              LAST_START_DATE = leser["LAST_START_DATE"] != DBNull.Value ? (DateTime?)Convert.ToDateTime(leser["LAST_START_DATE"]) : null,
              LAST_RUN_DURATION = leser["LAST_RUN_DURATION"]?.ToString(),
              COMMENTS = leser["COMMENTS"]?.ToString()
            });
          }
        }

        Logger.LogDebug("GetAuffaelligeJobList: {Anzahl} auffällige Jobs gefunden.", liste.Count);
      }
      catch (Exception ausnahme)
      {
        Logger.LogError(ausnahme, "Fehler in GetAuffaelligeJobList.");
      }

      return liste;
    }

    /// <summary>
    /// Ruft das Ausführungsprotokoll zu einem bestimmten Scheduler-Job ab.
    /// Sortiert nach log_id absteigend (neueste Einträge zuerst).
    /// </summary>
    /// <param name="jobName">Der exakte Name des Oracle Scheduler Jobs.</param>
    /// <returns>Liste der letzten Ausführungsdetails des angegebenen Jobs.</returns>
    public List<V_JOB_RUN_DETAILS> GetJobLog(string jobName)
    {
      var liste = new List<V_JOB_RUN_DETAILS>();

      if (string.IsNullOrWhiteSpace(jobName))
      {
        Logger.LogWarning("GetJobLog: Kein Job-Name übergeben.");
        return liste;
      }

      if (OraProvider?.OraController?.OracleConnection == null)
      {
        Logger.LogWarning("GetJobLog: Datenbankverbindung ist nicht initialisiert.");
        return liste;
      }

      const string sql = @"
          SELECT log_date, job_name, status,
                 req_start_date, run_duration
          FROM   dba_scheduler_job_run_details
          WHERE  job_name = :p_jobName
          ORDER BY log_id DESC";

      try
      {
        using (var befehl = new OracleCommand(sql, OraProvider.OraController.OracleConnection))
        {
          befehl.Parameters.Add(new OracleParameter("p_jobName", jobName));

          using (var leser = befehl.ExecuteReader())
          {
            while (leser.Read())
            {
              liste.Add(new V_JOB_RUN_DETAILS
              {
                LOG_DATE = leser["LOG_DATE"] != DBNull.Value ? (DateTime?)Convert.ToDateTime(leser["LOG_DATE"]) : null,
                JOB_NAME = leser["JOB_NAME"]?.ToString(),
                STATUS = leser["STATUS"]?.ToString(),
                REQ_START_DATE = leser["REQ_START_DATE"] != DBNull.Value ? (DateTime?)Convert.ToDateTime(leser["REQ_START_DATE"]) : null,
                RUN_DURATION = leser["RUN_DURATION"] != DBNull.Value ? leser["RUN_DURATION"].ToString() : "00:00:00"
              });
            }
          }
        }

        Logger.LogDebug("GetJobLog: {Anzahl} Protokolleinträge für '{JobName}' geladen.", liste.Count, jobName);
      }
      catch (Exception ausnahme)
      {
        Logger.LogError(ausnahme, "Fehler in GetJobLog für Job '{JobName}'.", jobName);
      }

      return liste;
    }

    #endregion

    #region Private Hilfsmethoden

    /// <summary>
    /// Formatiert einen SQL-Rohtext für die lesbare Darstellung im Detail-Panel.
    /// Fügt vor den wichtigsten SQL-Schlüsselwörtern einen Zeilenumbruch ein.
    /// Kompatibel mit C# 7.3 (kein String.Replace mit StringComparison-Overload).
    /// </summary>
    /// <param name="rohSql">Der zu formatierende SQL-Rohtext.</param>
    /// <returns>Formatierter, zeilenumgebrochener SQL-Text.</returns>
    private static string FormatSql(string rohSql)
    {
      if (string.IsNullOrWhiteSpace(rohSql)) return string.Empty;

      try
      {
        var formatter = new PoorMansTSqlFormatterLib.SqlFormattingManager();
        return formatter.Format(rohSql);
      }
      catch (Exception)
      {
        return rohSql;
      }
    }

    #endregion
  }
}
