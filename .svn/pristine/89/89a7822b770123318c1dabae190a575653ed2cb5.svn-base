          while (leser.Read())
          {
            liste.Add(new V_PROCESS
            {
              PID = leser["PID"] != DBNull.Value ? Convert.ToDecimal(leser["PID"]) : (decimal?)null,
              SPID = leser["SPID"] != DBNull.Value ? Convert.ToDecimal(leser["SPID"]) : (decimal?)null,
              USERNAME = leser["USERNAME"]?.ToString(),
              PROGRAM = leser["PROGRAM"]?.ToString(),
              ADDR = leser["ADDR"]?.ToString(),
              BACKGROUND = leser["BACKGROUND"]?.ToString(),
              PGA_USED_MEM = leser["PGA_USED_MEM"] != DBNull.Value ? Convert.ToDecimal(leser["PGA_USED_MEM"]) : 0,
              PGA_ALLOC_MEM = leser["PGA_ALLOC_MEM"] != DBNull.Value ? Convert.ToDecimal(leser["PGA_ALLOC_MEM"]) : 0
            });
