using System;
using System.Diagnostics;
using System.IO;
using System.Reflection;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Input;
using Bsd.DbMonitorData;
using Bsd.DbMonitorWPF;
using Bsd.DbMonitorWPF.Helpers;
using Bsd.DbMonitorWPF.ViewModels;
using Bsd.DbMonitorWPF.Views;
using Bsd.SharedObjects;
using Bsd.SharedObjects.Assemblies;
using Bsd.WPFObjects;
using Bsd.WPFObjects.Apps;
using Bsd.WPFObjects.Apps.Menu;
using Bsd.WPFObjects.Events;
using Bsd.WPFObjects.Helper;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Logging;

namespace Bsd.DbMonitor
{
  /// <summary>
  /// Zentrale Anwendungsklasse für den DbMonitor.
  /// Steuert Lebenszyklus, DI-Konfiguration und globale Event-Handler.
  /// </summary>
  public partial class App : BsdApplication
  {
    #region Konstruktor

    public App() : base()
    {
      InitializeCommands();
      RegisterGlobalEventHandlers();
    }

    private void InitializeCommands()
    {
      LogoffCommand = new RelayCommand(_ => OnLogoffCommand());
      CloseCommand = new RelayCommand(_ => OnCloseCommand());
      ReleaseNotesCommand = new RelayCommand(_ => OnReleaseNotesCommand());
    }

    private void RegisterGlobalEventHandlers()
    {
      EventManager.RegisterClassHandler(
          typeof(MenuItem),
          MenuItem.ClickEvent,
          new RoutedEventHandler(OnGlobalMenuItemClick)
      );
    }

    #endregion

    #region Commands

    public ICommand LogoffCommand { get; private set; }
    public ICommand CloseCommand { get; private set; }
    public ICommand ReleaseNotesCommand { get; private set; }

    #endregion

    #region Überschreibungen (BsdApplication)

    public override void ConfigureServices(ServiceCollection services)
    {
      // Modul-Registrierungen
      services.InitDependencyInjectionForSharedObjects();
      services.InitDependencyInjectionForBsdBaWueHe();
      services.InitDependencyInjectionForWpfObjects();
      services.InitDependencyInjectionForDbMonitorData();
      services.InitDependencyInjectionForDbMonitorWPF();

      // ViewModels
      services.AddTransient<SitzungenViewModel>();
      services.AddTransient<SperrenViewModel>();
      services.AddTransient<ProzesseViewModel>();
      services.AddTransient<JobsViewModel>();
      services.AddTransient<SqlhistorieViewModel>();
    }

    public override void AppIsStarting(string[] arguments)
    {
      EventSystem.LoggingEnabled = Debugger.IsAttached;
    }

    public override Window AppRequestsMainWindow()
    {
      var mainViewModel = ServiceProvider.GetService<MainViewModel>();
      var mainView = new MainView { DataContext = mainViewModel };

      var mainWindowModel = new MainWindowModel
      {
        MainControl = mainView,
        WindowTitle = "DbMonitor"
      };

      AddMenuItems(mainWindowModel);

      return new MainWindow { DataContext = mainWindowModel, WindowState = WindowState.Maximized };
    }

    public override void AppMainWindowIsOpened() => EventSystem.Publish(new RefreshStatusLineEvent());

    #endregion

    #region Private Methoden

    private void OnGlobalMenuItemClick(object sender, RoutedEventArgs e)
    {
      if (sender is MenuItem item && item.Header?.ToString() == "Zelle kopieren")
      {
        CellCopyHelper.CopyCell_Click(sender, e);
        e.Handled = true;
      }
    }

    private void AddMenuItems(MainWindowModel model)
    {
      model.MainMenuModels.Remove(model.GetMenuItem("File"));

      var workspace = new MenuItemModel("Arbeitsplatz", "Workspace");
      model.MainMenuModels.Insert(0, workspace);

      workspace.SubItems.Add(new MenuItemModel("Abmelden", "Workspace/Logoff", "/BSD_WPFObjects;component/Icons/Key.png", LogoffCommand));
      workspace.SubItems.Add(new MenuItemModel("Beenden", "Workspace/Close", "/BSD_WPFObjects;component/Icons/Beenden.png", CloseCommand));

      var help = model.GetMenuItem("Help");
      help.SubItems.Insert(0, new MenuItemModel("Versionsinformationen", "Help/ReleaseNotes", "/BSD_WPFObjects;component/Icons/Dokument.png", ReleaseNotesCommand));
    }

    private void OnLogoffCommand()
    {
      Logger.LogInformation("Application logout");
      EventSystem.Publish(new UserLoginEvent(LoginOperation.Logout, User.InterCode));
    }

    private void OnCloseCommand()
    {
      Logger.LogInformation("Application closing");
      if (BsdCurrent.MainWindow.DataContext is MainWindowModel vm)
      {
        vm.CloseApplication(false);
      }
    }

    private void OnReleaseNotesCommand() => LoadAndShowPdfDocument("ReleaseNotes.pdf", "Versionshistorie");

    private void LoadAndShowPdfDocument(string fileName, string titleBottom)
    {
      try
      {
        string folder = new AssemblyInfoReader(Assembly.GetExecutingAssembly()).AssemblyFolder;
        ShowPdfDialog("DbMonitor", titleBottom, Path.Combine(folder, fileName));
      }
      catch (Exception ex)
      {
        Logger.LogError(ex, $"Fehler beim Laden von PDF: {fileName}");
      }
    }

    private void ShowPdfDialog(string titleTop, string titleBottom, string pdfPath)
    {
      var vm = ServiceProvider.GetService<ReleaseNotesViewModel>();
      vm.TitleTop = titleTop;
      vm.TitleBottom = titleBottom;
      vm.PdfFile = pdfPath;
      vm.ZoomValue = 1.5;
      vm.CloseAction = () => EventSystem.Publish(ShadableStackEvent.Pop("MainWindow"));

      EventSystem.Publish(ShadableStackEvent.Push(new ReleaseNotesView { DataContext = vm }, "MainWindow", true, true));
    }

    #endregion
  }
}
