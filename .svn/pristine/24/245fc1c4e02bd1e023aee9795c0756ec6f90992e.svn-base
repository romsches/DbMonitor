using System;
using System.Collections.Generic;
using System.Collections.ObjectModel;
using System.ComponentModel;
using System.Windows;
using System.Windows.Data;
using System.Windows.Input;
using Bsd.Data.Entities;
using Bsd.Data.Helper;
using Bsd.DbMonitorData;
using Bsd.DbMonitorWPF.Helpers;
using Bsd.WPFObjects.Apps;
using Bsd.WPFObjects.Views;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Logging;
using Prism.Commands;

namespace Bsd.DbMonitorWPF.ViewModels
{
  public class SqlhistorieViewModel : DiViewModel
  {
    private V_SQL _ausgewaehltesSql;
    private string _filterTextSql;
    private bool _istSqlHistorieFormatiert = false;
    private string _statusSql;
    private string _sqlHistorieFormatiert;
    private string _rawSqlHistorie;
    private bool _istTop20SqlModus = false;

    // Eigenschaft für den Timer im MainViewModel
    public bool IstTop20Modus => _istTop20SqlModus;

    public ObservableCollection<V_SQL> SqlVerlauf { get; }
    public ICollectionView SqlVerlaufAnsicht { get; }

    public ICommand SqlAktualisierenBefehl { get; }
    public ICommand LadeTopSqlBefehl { get; }
    public ICommand AlleSqlLadenBefehl { get; }
    public ICommand KopiereHistorieSqlBefehl { get; }

    public SqlhistorieViewModel(IServiceProvider serviceProvider, IOraProvider oraProvider, ILogger<SqlhistorieViewModel> log)
        : base(serviceProvider, oraProvider, log)
    {
      SqlVerlauf = new ObservableCollection<V_SQL>();
      SqlVerlaufAnsicht = CollectionViewSource.GetDefaultView(SqlVerlauf);
      SqlVerlaufAnsicht.Filter = FilterSqlDelegate;

      SqlAktualisierenBefehl = new DelegateCommand(SqlAktualisierenAusfuehren);
      LadeTopSqlBefehl = new DelegateCommand(LadeTopSqlAusfuehren);
      AlleSqlLadenBefehl = new DelegateCommand(LadeAlleSqlAusfuehren);
      KopiereHistorieSqlBefehl = new DelegateCommand(KopiereHistorieSqlAusfuehren, () => AusgewaehltesSql != null);
    }

    public void SetTop20Mode(bool isTop20)
    {
      _istTop20SqlModus = isTop20;
    }

    public string StatusSql
    {
      get => _statusSql;
      set => SetVal(ref _statusSql, value);
    }

    public V_SQL AusgewaehltesSql
    {
      get => _ausgewaehltesSql;
      set
      {
        if (_ausgewaehltesSql == value) return;
        SetObj(ref _ausgewaehltesSql, value);
        AktualisiereHistorieSqlAnsicht();
        OnPropertyChanged(nameof(AktuellerHistorieSqlText));
        ((DelegateCommand)KopiereHistorieSqlBefehl).RaiseCanExecuteChanged();
      }
    }

    public bool IstSqlHistorieFormatiert
    {
      get => _istSqlHistorieFormatiert;
      set
      {
        SetVal(ref _istSqlHistorieFormatiert, value);
        OnPropertyChanged(nameof(AktuellerHistorieSqlText));
      }
    }

    public string AktuellerHistorieSqlText => AusgewaehltesSql == null
        ? string.Empty
        : (IstSqlHistorieFormatiert ? _rawSqlHistorie : _sqlHistorieFormatiert);

    public string FilterTextSql
    {
      get => _filterTextSql;
      set { SetVal(ref _filterTextSql, value); SqlVerlaufAnsicht.Refresh(); }
    }

    public void LadeTopSqlAusfuehren()
    {
      _istTop20SqlModus = true;
      LadeSqlDaten(true);
    }

    private void LadeAlleSqlAusfuehren()
    {
      _istTop20SqlModus = false;
      LadeSqlDaten(false);
    }

    private void SqlAktualisierenAusfuehren()
    {
      // Nutzt den Status aus _istTop20SqlModus, der beim Timer-Aufruf oder Button-Klick aktiv ist
      LadeSqlDaten(_istTop20SqlModus);
    }

    private void LadeSqlDaten(bool nurTop20)
    {
      StatusSql = "Wird geladen...";

      System.Threading.Tasks.Task.Run(() =>
      {
        var dbQuery = ServiceProvider.GetService<DbQuery>();
        var data = nurTop20
            ? (dbQuery?.GetTopExecutedSqlList() ?? new List<V_SQL>())
            : (dbQuery?.GetAllSqlList() ?? new List<V_SQL>());

        BsdApplication.InvokeIfRequired(() =>
        {
          CollectionAktualisieren(SqlVerlauf, data);
          SqlVerlaufAnsicht.Refresh();
          StatusSql = StatusHelper.FormatStatus(data.Count, nurTop20 ? "Top 20 SQL" : "SQL-Einträge");
        });
      });
    }

    private void KopiereHistorieSqlAusfuehren()
    {
      if (!string.IsNullOrEmpty(AktuellerHistorieSqlText))
        Clipboard.SetText(AktuellerHistorieSqlText);
    }

    private bool FilterSqlDelegate(object obj)
    {
      if (string.IsNullOrWhiteSpace(FilterTextSql)) return true;
      if (obj is V_SQL s)
      {
        string filter = FilterTextSql.ToUpper();
        return (s.SQL_ID?.ToUpper().Contains(filter) ?? false) ||
               (s.SQL_FULLTEXT?.ToUpper().Contains(filter) ?? false);
      }
      return false;
    }

    private void AktualisiereHistorieSqlAnsicht()
    {
      if (_ausgewaehltesSql == null || string.IsNullOrWhiteSpace(_ausgewaehltesSql.SQL_FULLTEXT))
      {
        _sqlHistorieFormatiert = string.Empty;
        _rawSqlHistorie = string.Empty;
      }
      else
      {
        _rawSqlHistorie = _ausgewaehltesSql.SQL_FULLTEXT;
        int index = _rawSqlHistorie.IndexOf("SELECT", StringComparison.OrdinalIgnoreCase);
        string cleanSql = (index > 0) ? _rawSqlHistorie.Substring(index).Trim() : _rawSqlHistorie;
        _sqlHistorieFormatiert = SqlFormatterHelper.Format(cleanSql);
      }
      OnPropertyChanged(nameof(AktuellerHistorieSqlText));
    }
  }
}
