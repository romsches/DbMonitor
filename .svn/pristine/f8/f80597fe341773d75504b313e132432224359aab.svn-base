using System;
using System.Collections.Generic;
using System.Data;
using System.Text;
using Bsd.Data.BL;
using Bsd.Data.DependencyInjection;
using Bsd.Data.Entities;
using Bsd.Data.Helper;
using Microsoft.Extensions.Logging;
using Oracle.ManagedDataAccess.Client;

namespace Bsd.DbMonitorData
{
  /// <summary>
  /// Zentraler Datenzugriff auf Oracle-Systemviews für das DB-Monitor-Tool.
  ///
  /// Stellt typsichere, parametrisierte Abfragen bereit für:
  ///   – Aktive Sitzungen        (V$SESSION)
  ///   – SQL-Statements          (V$SQL, V$SQL_BIND_CAPTURE)
  ///   – Serverprozesse          (V$PROCESS)
  ///   – Transaktionssperren     (V$LOCK)
  ///   – Scheduler-Jobs          (DBA_SCHEDULER_JOBS)
  ///   – Audit-Log               (BSD_DBMONITOR_AUDIT_LOG)
  ///
  /// Alle Methoden sind fehlergesichert (try/catch + ILogger),
  /// NULL-sicher und geben stets eine leere Liste zurück – niemals null.
  /// Präsentationslogik (Formatierung) verbleibt in der ViewModel-Schicht.
  /// </summary>
  public class DbQuery : DiDatabaseModel
  {
    #region Konstruktor

    /// <summary>
    /// Initialisiert eine neue Instanz mit Dependency Injection
    /// für ServiceProvider, OraProvider und Logger.
    /// </summary>
    public DbQuery(
        IServiceProvider serviceProvider,
        IOraProvider oraProvider,
        ILogger<DbQuery> logger)
        : base(serviceProvider, oraProvider, logger)
    {
    }

    #endregion

    #region Öffentliche Methoden – Verbindung

    /// <summary>
    /// Wechselt die aktive Datenbankverbindung anhand eines Verbindungs-Alias
    /// aus der App.config (z. B. "CTSP", "CTSS", "BWDEMO").
    /// </summary>
    /// <param name="dbAlias">Name des Verbindungs-Alias aus der App.config.</param>
    /// <exception cref="Exception">Wird weitergereicht, wenn der Verbindungsaufbau fehlschlägt.</exception>
    public void SetDatabase(string dbAlias)
    {
      var connectionString = System.Configuration.ConfigurationManager
          .ConnectionStrings[dbAlias]?.ConnectionString;

      if (string.IsNullOrEmpty(connectionString))
      {
        Logger.LogError("SetDatabase: Verbindungszeichenfolge für '{DbAlias}' nicht gefunden.", dbAlias);
        return;
      }

      try
      {
        var conn = OraProvider.OraController.OracleConnection;
        if (conn.State == ConnectionState.Open) conn.Close();
        conn.ConnectionString = connectionString;
        conn.Open();
        Logger.LogInformation("SetDatabase: Verbindung zu '{DbAlias}' hergestellt.", dbAlias);
      }
      catch (Exception ex)
      {
        Logger.LogError(ex, "SetDatabase: Fehler beim Wechsel zu '{DbAlias}'.", dbAlias);
        throw;
      }
    }

    #endregion

    #region Öffentliche Methoden – V$SESSION

    /// <summary>
    /// Ermittelt alle aktiven Benutzersitzungen aus V$SESSION.
    /// Hintergrundprozesse (USERNAME IS NULL) werden ausgeschlossen.
    /// Sortierung: Status aufsteigend (ACTIVE zuerst), dann SID aufsteigend.
    /// </summary>
    public List<V_SESSION_MONITOR> GetAktuelleSessionsList()
    {
      const string sql = @"
          SELECT s.sid,
                 s.serial#    AS serial,
                 s.username,
                 s.osuser,
                 s.machine,
                 s.terminal,
                 s.program,
                 s.type,
                 s.status,
                 s.logon_time,
                 p.spid       AS process_id
          FROM   v$session s
          JOIN   v$process p ON s.paddr = p.addr
          WHERE  s.username IS NOT NULL
          ORDER BY s.status ASC, s.sid ASC";

      return AusfuehrenUndLesen(sql, leser => new V_SESSION_MONITOR
      {
        SID = LeseDecimalNull(leser, "SID"),
        SERIAL = LeseDecimalNull(leser, "SERIAL"),
        USERNAME = leser["USERNAME"]?.ToString(),
        OSUSER = leser["OSUSER"]?.ToString(),
        MACHINE = leser["MACHINE"]?.ToString(),
        TERMINAL = leser["TERMINAL"]?.ToString(),
        PROGRAM = leser["PROGRAM"]?.ToString(),
        TYPE = leser["TYPE"]?.ToString(),
        STATUS = leser["STATUS"]?.ToString(),
        LOGON_TIME = LeseDateTimeNull(leser, "LOGON_TIME"),
        PROCESS_ID = leser["PROCESS_ID"]?.ToString()
      }, nameof(GetAktuelleSessionsList));
    }

    /// <summary>
    /// Ruft den SQL-Rohtext und die Bind-Variablen der aktuell ausgeführten
    /// Anweisung einer Sitzung ab.
    ///
    /// Rückgabe: <see cref="SqlTextErgebnis"/> mit RohSql, BindVars.
    /// Formatierung (Pretty-Print) erfolgt in der ViewModel-Schicht.
    /// </summary>
    /// <param name="sid">Session-ID.</param>
    /// <param name="serial">Seriennummer der Sitzung (SERIAL#).</param>
    public SqlTextErgebnis GetCurrentSqlText(decimal sid, decimal serial)
    {
      if (!VerbindungPruefen(nameof(GetCurrentSqlText)))
        return SqlTextErgebnis.Leer("Hinweis: Keine Datenbankverbindung.");

      const string sqlText = @"
          SELECT q.sql_fulltext AS sql_text, q.sql_id
          FROM   v$session s
          JOIN   v$sql    q ON q.hash_value = s.sql_hash_value
                            AND q.address   = s.sql_address
          WHERE  s.sid     = :p_sid
          AND    s.serial# = :p_serial
          AND    ROWNUM    = 1";

      const string bindVarsSql = @"
          SELECT b.name           AS bind_name,
                 b.value_string   AS bind_wert,
                 b.datatype_string AS bind_typ
          FROM   v$session         s
          JOIN   v$sql_bind_capture b ON b.sql_id = s.sql_id
          WHERE  s.sid     = :p_sid
          AND    s.serial# = :p_serial
          ORDER BY b.position ASC";

      try
      {
        string rohSql = string.Empty;
        string sqlId = string.Empty;
        string bindVars = string.Empty;

        using (var cmd = ErstelleBefehl(sqlText))
        {
          cmd.Parameters.Add("p_sid", OracleDbType.Decimal).Value = sid;
          cmd.Parameters.Add("p_serial", OracleDbType.Decimal).Value = serial;

          using (var leser = cmd.ExecuteReader())
          {
            if (leser.Read() && leser["SQL_TEXT"] != DBNull.Value)
            {
              rohSql = leser["SQL_TEXT"].ToString();
              sqlId = leser["SQL_ID"]?.ToString() ?? string.Empty;
            }
          }
        }

        if (string.IsNullOrEmpty(rohSql))
          return SqlTextErgebnis.Leer("Hinweis: Kein aktives SQL gefunden.");

        if (!string.IsNullOrEmpty(sqlId))
        {
          using (var cmd = ErstelleBefehl(bindVarsSql))
          {
            cmd.Parameters.Add("p_sid", OracleDbType.Decimal).Value = sid;
            cmd.Parameters.Add("p_serial", OracleDbType.Decimal).Value = serial;

            using (var leser = cmd.ExecuteReader())
            {
              var sb = new StringBuilder();
              while (leser.Read())
                sb.AppendLine($"{leser["BIND_NAME"]} = {leser["BIND_WERT"]} [{leser["BIND_TYP"]}]");
              bindVars = sb.ToString().Trim();
            }
          }
        }

        return new SqlTextErgebnis(rohSql, string.Empty, bindVars);
      }
      catch (Exception ex)
      {
        Logger.LogError(ex, "Fehler in GetCurrentSqlText SID={Sid}.", sid);
        return SqlTextErgebnis.Leer($"Fehler: {ex.Message}");
      }
    }

    /// <summary>
    /// Beendet eine Datenbanksitzung sofort (IMMEDIATE) und schreibt
    /// einen Audit-Log-Eintrag in BSD_DBMONITOR_AUDIT_LOG.
    ///
    /// Voraussetzung: Das Oracle-Recht ALTER SYSTEM muss dem Benutzer erteilt sein.
    /// </summary>
    /// <param name="sid">Session-ID.</param>
    /// <param name="serial">Seriennummer der Sitzung.</param>
    /// <param name="grund">Begründung für das Session-Kill (Pflichtfeld im Dialog).</param>
    /// <param name="sqlText">Zuletzt ausgeführter SQL-Text (kann leer sein).</param>
    /// <param name="programm">Programm der Session.</param>
    /// <param name="osBenutzer">OS-Benutzer der Session.</param>
    /// <param name="terminal">Terminal der Session.</param>
    /// <exception cref="Exception">Wird weitergereicht, damit der Aufrufer reagieren kann.</exception>
    public void KillSession(
        decimal sid, decimal serial,
        string grund, string sqlText,
        string programm, string osBenutzer, string terminal)
    {
      if (!VerbindungPruefen(nameof(KillSession))) return;

      try
      {
        // 1. Session beenden
        using (var cmd = ErstelleBefehl("begin system.p_kill_session(:1, :2); end;"))
        {
          cmd.Parameters.Add("1", OracleDbType.Decimal).Value = sid;
          cmd.Parameters.Add("2", OracleDbType.Decimal).Value = serial;
          try { cmd.ExecuteNonQuery(); }
          catch (OracleException ex) when (ex.Number == 31) { /* Session wird bereits beendet */ }
        }

        // 2. Audit-Eintrag schreiben
        const string auditSql = @"
            INSERT INTO sysmon.BSD_DBMONITOR_AUDIT_LOG
              (DAL_ID, KILL_DATE, DAL_SID, DAL_SERIAL,
               DAL_REASON, DAL_USERNAME, DAL_SQL_TEXT,
               DAL_PROGRAM, DAL_OSUSER, DAL_TERMINAL, INTER_CODE)
            VALUES
              ((SELECT NVL(MAX(DAL_ID), 0) + 1 FROM sysmon.BSD_DBMONITOR_AUDIT_LOG),
               SYSDATE, :sid, :serial,
               :reason, USER, :sqlText,
               :program, :osUser, :terminal, 'KILL')";

        using (var cmd = ErstelleBefehl(auditSql))
        {
          cmd.Parameters.Add("sid", sid);
          cmd.Parameters.Add("serial", serial);
          cmd.Parameters.Add("reason", grund ?? "Kein Grund angegeben");
          cmd.Parameters.Add("sqlText", (object)(sqlText ?? string.Empty) == string.Empty
                                            ? DBNull.Value : (object)sqlText);
          cmd.Parameters.Add("program", (object)programm ?? DBNull.Value);
          cmd.Parameters.Add("osUser", (object)osBenutzer ?? DBNull.Value);
          cmd.Parameters.Add("terminal", (object)terminal ?? DBNull.Value);
          cmd.ExecuteNonQuery();
        }

        Logger.LogInformation("KillSession: SID={Sid} SERIAL={Serial} beendet.", sid, serial);
      }
      catch (Exception ex)
      {
        Logger.LogError(ex, "KillSession: Fehler bei SID={Sid}.", sid);
        throw;
      }
    }

    #endregion

    #region Öffentliche Methoden – V$SQL

    /// <summary>
    /// Ruft die Top 100 SQL-Statements aus dem Shared Pool ab,
    /// sortiert nach Puffer-Lesezugriffen (BUFFER_GETS) absteigend.
    /// </summary>
    public List<V_SQL> GetAllSqlList()
    {
      const string sql = @"
          SELECT sql_id, sql_fulltext, executions,
                 disk_reads, buffer_gets, cpu_time
          FROM (
              SELECT sql_id, sql_fulltext, executions,
                     disk_reads, buffer_gets, cpu_time
              FROM   v$sql
              ORDER BY buffer_gets DESC
          ) WHERE ROWNUM <= 100";

      return AusfuehrenUndLesen(sql, LeseSqlZeile, nameof(GetAllSqlList));
    }

    /// <summary>
    /// Analyse-Modus: Top 20 SQL-Statements nach Ausführungsanzahl (EXECUTIONS) absteigend.
    /// </summary>
    public List<V_SQL> GetTopExecutedSqlList()
    {
      const string sql = @"
          SELECT sql_id, sql_fulltext, executions,
                 disk_reads, buffer_gets, cpu_time
          FROM (
              SELECT sql_id, sql_fulltext, executions,
                     disk_reads, buffer_gets, cpu_time
              FROM   v$sql
              ORDER BY executions DESC
          ) WHERE ROWNUM <= 20";

      return AusfuehrenUndLesen(sql, LeseSqlZeile, nameof(GetTopExecutedSqlList));
    }

    #endregion

    #region Öffentliche Methoden – V$PROCESS

    /// <summary>
    /// Ruft alle Oracle-Serverprozesse ab, sortiert nach PGA-Speicher absteigend.
    /// </summary>
    public List<V_PROCESS> GetAllProcessesList()
    {
      const string sql = @"
          SELECT pid, spid, username, program,
                 RAWTOHEX(addr) AS addr,
                 background,
                 pga_used_mem, pga_alloc_mem,
                 ROUND(pga_used_mem / 1024 / 1024, 2) AS pga_used_mb
          FROM   v$process
          ORDER BY pga_used_mem DESC";

      return AusfuehrenUndLesen(sql, LeseProzessZeile, nameof(GetAllProcessesList));
    }

    /// <summary>
    /// Analyse-Modus: Top 20 Oracle-Prozesse nach PGA-Speicherauslastung.
    /// </summary>
    public List<V_PROCESS> GetTopMemoryProcessesList()
    {
      const string sql = @"
          SELECT pid, spid, username, program,
                 RAWTOHEX(addr) AS addr,
                 background,
                 pga_used_mem, pga_alloc_mem,
                 ROUND(pga_used_mem / 1024 / 1024, 2) AS pga_used_mb
          FROM (
              SELECT pid, spid, username, program, addr,
                     background, pga_used_mem, pga_alloc_mem
              FROM   v$process
              ORDER BY pga_used_mem DESC
          ) WHERE ROWNUM <= 20";

      return AusfuehrenUndLesen(sql, LeseProzessZeile, nameof(GetTopMemoryProcessesList));
    }

    #endregion

    #region Öffentliche Methoden – V$LOCK

    /// <summary>
    /// Ruft alle aktiven Transaktionssperren aus V$LOCK ab.
    /// Enthält lesbare Lock-Mode-Bezeichnungen via DECODE.
    /// Sortiert nach SID aufsteigend.
    /// </summary>
    public List<V_LOCK> GetLockList()
    {
      const string sql = @"
          SELECT DISTINCT
                 s.sid, s.serial# AS serial,
                 s.username, s.osuser, s.machine,
                 s.terminal, s.program, s.status, s.logon_time,
                 s.type AS session_type,
                 l.id1, l.type,
                 DECODE(l.lmode,
                     0,'Waiting', 1,'Null', 2,'Row Shr', 3,'Row Exc',
                     4,'Share',   5,'Shr Row X', 6,'Exclusive',
                     TO_CHAR(l.lmode)) AS status_aktuell,
                 DECODE(l.request,
                     0,'None', 1,'Null', 2,'Row Shr', 3,'Row Exc',
                     4,'Share', 5,'Shr Row X', 6,'Exclusive',
                     TO_CHAR(l.request)) AS angefragt
          FROM   v$session s
          JOIN   v$lock    l ON s.sid = l.sid
          WHERE  l.block > 0 OR l.request > 0
          ORDER BY s.sid";

      return AusfuehrenUndLesen(sql, leser => new V_LOCK
      {
        SID = LeseDecimal(leser, "SID"),
        SERIAL = LeseDecimal(leser, "SERIAL"),
        USERNAME = leser["USERNAME"]?.ToString(),
        OSUSER = leser["OSUSER"]?.ToString(),
        MACHINE = leser["MACHINE"]?.ToString(),
        TERMINAL = leser["TERMINAL"]?.ToString(),
        PROGRAM = leser["PROGRAM"]?.ToString(),
        STATUS = leser["STATUS"]?.ToString(),
        LOGON_TIME = LeseDateTimeNull(leser, "LOGON_TIME"),
        SESSION_TYPE = leser["SESSION_TYPE"]?.ToString(),
        ID1 = leser["ID1"]?.ToString(),
        TYPE = leser["TYPE"]?.ToString(),
        STATUS_AKTUELL = leser["STATUS_AKTUELL"]?.ToString(),
        ANGEFRAGT = leser["ANGEFRAGT"]?.ToString()
      }, nameof(GetLockList));
    }

    #endregion

    #region Öffentliche Methoden – DBA_SCHEDULER_JOBS
    /// <summary>
    /// Ruft alle aktiven Scheduler-Jobs des Owners 'SYSADM' ab (außer DISABLED).
    /// Wird in der Jobs-Übersichtstabelle angezeigt.
    /// </summary>
    public List<V_JOB> GetAlleJobList()
    {
      const string sql = @"
      SELECT
          j.job_name,
          j.job_action,
          j.state,
          j.start_date,
          j.last_start_date,
          j.next_run_date,
          j.repeat_interval,
          j.run_count,
          j.failure_count,
          l.status
      FROM dba_scheduler_jobs j
      LEFT JOIN (
          SELECT *
          FROM (
              SELECT
                  l.*,
                  ROW_NUMBER() OVER (
                      PARTITION BY l.job_name
                      ORDER BY l.log_date DESC
                  ) AS rn
              FROM dba_scheduler_job_log l
          )
          WHERE rn = 1
      ) l ON j.job_name = l.job_name
      WHERE j.owner = 'SYSADM'
        AND j.state != 'DISABLED'
      ORDER BY j.state ASC, j.job_name ASC";

      return AusfuehrenUndLesen(sql, leser => new V_JOB
      {
        JOB_NAME = leser["JOB_NAME"]?.ToString(),
        JOB_ACTION = leser["JOB_ACTION"]?.ToString(),
        STATE = leser["STATE"]?.ToString(),
        START_DATE = LeseDateTimeOffsetNull(leser, "START_DATE"),
        LAST_START_DATE = LeseDateTimeOffsetNull(leser, "LAST_START_DATE"),
        NEXT_RUN_DATE = LeseDateTimeOffsetNull(leser, "NEXT_RUN_DATE"),
        REPEAT_INTERVAL = leser["REPEAT_INTERVAL"]?.ToString(),
        RUN_COUNT = LeseDecimal(leser, "RUN_COUNT"),
        FAILURE_COUNT = LeseDecimal(leser, "FAILURE_COUNT"),
        STATUS = leser["STATUS"]?.ToString()
      }, nameof(GetAlleJobList));
    }

    /// <summary>
    /// Ruft alle auffälligen Scheduler-Jobs des Owners 'SYSADM' ab.
    ///
    /// Als auffällig gilt ein Job, wenn:
    ///   – der Job-Status selbst nicht 'SCHEDULED' ist (z. B. BROKEN, FAILED, STOPPED), ODER
    ///   – die letzte Ausführung laut DBA_SCHEDULER_JOB_LOG fehlgeschlagen ist
    ///     (STATUS != 'SUCCEEDED' bei OPERATION = 'RUN'), obwohl der Job noch auf SCHEDULED steht.
    /// </summary>
    public List<V_JOB> GetAuffaelligeJobList()
    {
      const string sql = @"
      SELECT
          j.job_name,
          j.job_action,
          j.state,
          j.start_date,
          j.last_start_date,
          j.next_run_date,
          j.repeat_interval,
          j.run_count,
          j.failure_count,
          l.status
      FROM dba_scheduler_jobs j
      LEFT JOIN (
          SELECT *
          FROM (
              SELECT
                  l.*,
                  ROW_NUMBER() OVER (
                      PARTITION BY l.job_name
                      ORDER BY l.log_date DESC
                  ) AS rn
              FROM dba_scheduler_job_log l
          )
          WHERE rn = 1
      ) l ON j.job_name = l.job_name
      WHERE j.owner = 'SYSADM'
        AND j.state != 'DISABLED'
        AND (
            j.state != 'SCHEDULED'
            OR (l.status != 'SUCCEEDED' AND l.operation = 'RUN')
        )
      ORDER BY j.state ASC, j.job_name ASC";

      return AusfuehrenUndLesen(sql, leser => new V_JOB
      {
        JOB_NAME = leser["JOB_NAME"]?.ToString(),
        JOB_ACTION = leser["JOB_ACTION"]?.ToString(),
        STATE = leser["STATE"]?.ToString(),
        START_DATE = LeseDateTimeOffsetNull(leser, "START_DATE"),
        LAST_START_DATE = LeseDateTimeOffsetNull(leser, "LAST_START_DATE"),
        NEXT_RUN_DATE = LeseDateTimeOffsetNull(leser, "NEXT_RUN_DATE"),
        REPEAT_INTERVAL = leser["REPEAT_INTERVAL"]?.ToString(),
        RUN_COUNT = LeseDecimal(leser, "RUN_COUNT"),
        FAILURE_COUNT = LeseDecimal(leser, "FAILURE_COUNT"),
        STATUS = leser["STATUS"]?.ToString()
      }, nameof(GetAuffaelligeJobList));
    }

    /// <summary>
    /// Ruft das Ausführungsprotokoll eines Scheduler-Jobs ab (neueste Einträge zuerst).
    /// </summary>
    /// <param name="jobName">Exakter Name des Oracle Scheduler Jobs.</param>
    public List<V_JOB_RUN_DETAILS> GetJobLog(string jobName)
    {
      if (string.IsNullOrWhiteSpace(jobName))
      {
        Logger.LogWarning("GetJobLog: Kein Job-Name übergeben.");
        return new List<V_JOB_RUN_DETAILS>();
      }

      const string sql = @"
          SELECT log_date, job_name, status,
                 req_start_date, run_duration
          FROM   dba_scheduler_job_run_details
          WHERE  job_name = :p_jobName
          ORDER BY log_id DESC";

      if (!VerbindungPruefen(nameof(GetJobLog)))
        return new List<V_JOB_RUN_DETAILS>();

      var liste = new List<V_JOB_RUN_DETAILS>();
      try
      {
        using (var cmd = ErstelleBefehl(sql))
        {
          cmd.Parameters.Add(new OracleParameter("p_jobName", jobName));
          using (var leser = cmd.ExecuteReader())
          {
            while (leser.Read())
            {
              liste.Add(new V_JOB_RUN_DETAILS
              {
                LOG_DATE = LeseDateTimeOffsetNull(leser, "LOG_DATE"),
                JOB_NAME = leser["JOB_NAME"]?.ToString(),
                STATUS = leser["STATUS"]?.ToString(),
                REQ_START_DATE = LeseDateTimeOffsetNull(leser, "REQ_START_DATE"),
                RUN_DURATION = leser["RUN_DURATION"] != DBNull.Value
                       ? leser["RUN_DURATION"].ToString()
                       : "00:00:00"
              });
            }
          }
        }
        Logger.LogDebug("GetJobLog: {Anzahl} Einträge für '{JobName}' geladen.", liste.Count, jobName);
      }
      catch (Exception ex)
      {
        Logger.LogError(ex, "Fehler in GetJobLog für Job '{JobName}'.", jobName);
      }
      return liste;
    }

    #endregion

    #region Öffentliche Methoden – Audit-Log

    /// <summary>
    /// Ruft alle Einträge aus dem Audit-Log (BSD_DBMONITOR_AUDIT_LOG) ab,
    /// sortiert nach Zeitstempel absteigend (neueste zuerst).
    /// </summary>
    public List<AuditLogEntry> GetAuditLogEntries()
    {
      const string sql = @"
          SELECT * FROM sysmon.BSD_DBMONITOR_AUDIT_LOG
          ORDER BY KILL_DATE DESC";

      return AusfuehrenUndLesen(sql, leser => new AuditLogEntry
      {
        DAL_ID = LeseDecimal(leser, "DAL_ID"),
        INTER_CODE = leser["INTER_CODE"]?.ToString(),
        KILL_DATE = Convert.ToDateTime(leser["KILL_DATE"]),
        DAL_REASON = leser["DAL_REASON"]?.ToString(),
        DAL_SID = LeseDecimal(leser, "DAL_SID"),
        DAL_SERIAL = LeseDecimal(leser, "DAL_SERIAL"),
        DAL_USERNAME = leser["DAL_USERNAME"]?.ToString(),
        DAL_OSUSER = leser["DAL_OSUSER"]?.ToString(),
        DAL_TERMINAL = leser["DAL_TERMINAL"]?.ToString(),
        DAL_PROGRAM = leser["DAL_PROGRAM"]?.ToString(),
        DAL_LOGON_TIME = LeseDateTimeNull(leser, "DAL_LOGON_TIME"),
        DAL_SQL_TEXT = leser["DAL_SQL_TEXT"]?.ToString()
      }, nameof(GetAuditLogEntries));
    }

    #endregion

    #region Private Hilfsmethoden

    /// <summary>
    /// Führt ein SQL-Statement aus und wandelt jede Zeile per <paramref name="mapper"/> in
    /// ein Objekt um. Fehlergesichert – gibt im Fehlerfall eine leere Liste zurück.
    /// </summary>
    private List<T> AusfuehrenUndLesen<T>(
        string sql,
        Func<OracleDataReader, T> mapper,
        string methodenName)
    {
      var liste = new List<T>();
      if (!VerbindungPruefen(methodenName)) return liste;

      try
      {
        using (var cmd = ErstelleBefehl(sql))
        using (var leser = cmd.ExecuteReader())
        {
          while (leser.Read()) liste.Add(mapper(leser));
        }
        Logger.LogDebug("{Methode}: {Anzahl} Einträge geladen.", methodenName, liste.Count);
      }
      catch (Exception ex)
      {
        Logger.LogError(ex, "Fehler in {Methode}.", methodenName);
      }
      return liste;
    }

    /// <summary>Erstellt einen parametrisierten OracleCommand mit aktiver Verbindung.</summary>
    private OracleCommand ErstelleBefehl(string sql)
    {
      if (OraProvider?.OraController?.OracleConnection == null)
        throw new InvalidOperationException("Datenbankverbindung ist nicht verfügbar.");
      return new OracleCommand(sql, OraProvider.OraController.OracleConnection) { BindByName = true };
    }
    /// <summary>Prüft ob die Datenbankverbindung initialisiert ist.</summary>
    private bool VerbindungPruefen(string methodenName)
    {
      if (OraProvider?.OraController?.OracleConnection != null) return true;
      Logger.LogWarning("{Methode}: Datenbankverbindung ist nicht initialisiert.", methodenName);
      return false;
    }

    // --- Zeilen-Mapper (wiederverwendet von Get*All* und Get*Top*) ---

    private static V_SQL LeseSqlZeile(OracleDataReader leser) => new V_SQL
    {
      SQL_ID = leser["SQL_ID"]?.ToString(),
      SQL_FULLTEXT = leser["SQL_FULLTEXT"]?.ToString() ?? string.Empty,
      EXECUTIONS = LeseDecimal(leser, "EXECUTIONS"),
      DISK_READS = LeseDecimal(leser, "DISK_READS"),
      BUFFER_GETS = LeseDecimal(leser, "BUFFER_GETS"),
      CPU_TIME = LeseDecimal(leser, "CPU_TIME")
    };

    private static V_PROCESS LeseProzessZeile(OracleDataReader leser) => new V_PROCESS
    {
      PID = LeseDecimalNull(leser, "PID"),
      SPID = LeseDecimalNull(leser, "SPID"),
      USERNAME = leser["USERNAME"]?.ToString(),
      PROGRAM = leser["PROGRAM"]?.ToString(),
      ADDR = leser["ADDR"]?.ToString(),
      BACKGROUND = leser["BACKGROUND"]?.ToString(),
      PGA_USED_MEM = LeseDecimal(leser, "PGA_USED_MEM"),
      PGA_ALLOC_MEM = LeseDecimal(leser, "PGA_ALLOC_MEM"),
      PGA_USED_MB = LeseDecimal(leser, "PGA_USED_MB")
    };

    /// <summary>
    /// Liest einen TIMESTAMP WITH TIME ZONE Wert (DateTimeOffset) als DateTime aus.
    /// Wird für Spalten aus DBA_SCHEDULER_JOBS benötigt.
    /// </summary>
    private static DateTime? LeseDateTimeOffsetNull(OracleDataReader leser, string spalte)
    {
      if (leser[spalte] == DBNull.Value) return null;
      if (leser[spalte] is DateTimeOffset dto) return dto.LocalDateTime;
      return Convert.ToDateTime(leser[spalte]);
    }

    // --- Null-sichere Lese-Hilfsmethoden ---

    private static decimal LeseDecimal(OracleDataReader leser, string spalte) =>
        leser[spalte] != DBNull.Value ? Convert.ToDecimal(leser[spalte]) : 0m;

    private static decimal? LeseDecimalNull(OracleDataReader leser, string spalte) =>
        leser[spalte] != DBNull.Value ? Convert.ToDecimal(leser[spalte]) : (decimal?)null;

    private static DateTime? LeseDateTimeNull(OracleDataReader leser, string spalte) =>
        leser[spalte] != DBNull.Value ? (DateTime?)Convert.ToDateTime(leser[spalte]) : null;

    #endregion
  }
}
